#!/usr/bin/env python3
"""Optional source-checkout commit message and identity checks (stdlib only)."""

from __future__ import annotations

from pathlib import Path
import re
import subprocess
import sys


ATTRIBUTION_TRAILER = re.compile(r"^[ \t]*[a-z][a-z -]*[- ]by[ \t]*:", re.I | re.M)
INTERNAL_CODE = re.compile(r"\b(?:W[0-9]{2}|F[0-9]+|M1[ab]|M2)\b|cwor-", re.I)
AUTHORSHIP = (
    r"(?:generated|written|authored|co-?authored|co-developed|created|produced|implemented|"
    r"developed|assisted|built|made|prepared|reviewed|pair[- ]programmed)"
)
TOOL = (
    r"(?:AI|artificial intelligence|LLMs?|GPT(?:-[0-9.]+)?|ChatGPT|Codex|Claude(?: Code)?|"
    r"Copilot|Cursor|Gemini|OpenAI|Anthropic|DeepSeek|Qwen|Llama|bots?|tools?|assistants?)"
)
CREDIT_LINE = re.compile(
    rf"^[ \t]*(?:🤖[ \t]*)?{AUTHORSHIP}[ \t]+(?:by|with|using|via)\b"
    rf"|\b{AUTHORSHIP}[ \t]+(?:by|with|using|via)\b[^\n]*?\b{TOOL}\b"
    rf"|\b{TOOL}[- \t]+{AUTHORSHIP}\b"
    rf"|\b(?:thanks[ \t]+to|credit[ \t]+to|powered[ \t]+by|"
    rf"(?:help|assistance)[ \t]+from)\b[^\n]*?\b{TOOL}\b",
    re.I | re.M,
)


def git_output(*args: str) -> str:
    result = subprocess.run(["git", *args], capture_output=True, text=True, check=False, timeout=15)
    if result.returncode:
        detail = result.stderr.strip() or "value is not configured"
        raise ValueError(f"git {' '.join(args)}: {detail}")
    return result.stdout.rstrip("\n")


def check_identity() -> None:
    configured = []
    for setting in ("user.name", "user.email"):
        value = git_output("config", "--get", setting)
        if not value.strip():
            raise ValueError(f"configure a nonempty {setting} with git config --local {setting} VALUE")
        configured.append(value)
    expected = f"{configured[0]} <{configured[1]}>"
    for role in ("AUTHOR", "COMMITTER"):
        # git var resolves Git's actual identity, including environment and --author overrides.
        ident = git_output("var", f"GIT_{role}_IDENT")
        match = re.fullmatch(r"(.+) -?[0-9]+ [+-][0-9]{4}", ident)
        if not match:
            raise ValueError(f"cannot read Git's {role.lower()} identity")
        actual = match.group(1)
        if actual != expected:
            raise ValueError(
                f"{role.lower()} identity {actual!r} differs from configured user.name/user.email "
                f"{expected!r}; check Git identity overrides"
            )


def main() -> int:
    try:
        if len(sys.argv) != 2:
            raise ValueError("expected one commit message file")
        message = Path(sys.argv[1]).read_text(encoding="utf-8")
        if ATTRIBUTION_TRAILER.search(message) or CREDIT_LINE.search(message):
            raise ValueError("remove attribution trailers and credit lines from the commit message")
        if INTERNAL_CODE.search(message):
            raise ValueError("replace internal tracking labels with a public description in the commit message")
        check_identity()
    except (OSError, UnicodeError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"commit-msg: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
