{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestration Bead Metadata",
  "type": "object",
  "required": ["executor", "dispatch_mode", "share_boundary", "architect_review_required"],
  "properties": {
    "executor": {"type": "string"},
    "dispatch_mode": {"type": "string"},
    "task_class": {"type": "string"},
    "review_stage": {"type": "string"},
    "required_experts": {"type": "array", "items": {"type": "string"}},
    "share_boundary": {"type": "string"},
    "data_sensitivity": {"type": "string"},
    "codex_pickup": {"type": "string"},
    "architect_review_required": {"type": "boolean"},
    "acceptance_bead_required": {"type": "boolean"}
  }
}
