{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwo:policy/contracting-controls:v1",
  "title": "CWO Contracting Controls Policy",
  "description": "Whole-document schema for policy/contracting-controls.yaml version 1, checked by cwo_core.policy_schema whenever the policy is loaded. It uses only the bounded keyword subset that cwo_core.policy_schema supports. Threshold ordering (peer review < architect escalation < quarantine; peer review < reject) is checked by cwo_core.return_risk, which also refuses caller threshold overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "contracting_mode",
    "default_share_boundary",
    "allowed_external_executors",
    "manual_dispatch_required",
    "api_dispatch_enabled",
    "local_dispatch_enabled",
    "quota_policy",
    "peer_review_policy",
    "sabotage_policy",
    "return_language_calibration",
    "malpractice_policy",
    "fail_closed"
  ],
  "properties": {
    "version": {"const": 1},
    "schema": {"const": "json-compatible-yaml"},
    "contracting_mode": {"const": "manual-first"},
    "default_share_boundary": {"enum": ["no-outside-sharing", "redacted-packet", "repo-readonly", "patch-branch"]},
    "allowed_external_executors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "manual_dispatch_required": {"type": "boolean"},
    "api_dispatch_enabled": {"type": "boolean"},
    "local_dispatch_enabled": {"type": "boolean"},
    "quota_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_manual_dispatches_per_epic", "local_worker_dispatches_per_epic"],
      "properties": {
        "external_manual_dispatches_per_epic": {"type": "integer", "minimum": 0},
        "local_worker_dispatches_per_epic": {"type": "integer", "minimum": 0}
      }
    },
    "peer_review_policy": {
      "description": "Read by validate_repository.py (allowed_peer_executors cross-check). Runtime peer-review requirements come from policy/peer-review-policy.yaml.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_for_routes",
        "required_for_provider_conflict",
        "allowed_peer_executors",
        "cross_provider_required",
        "human_adjudication_on_disagreement"
      ],
      "properties": {
        "required_for_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["external-contract", "local-worker", "architect-review", "internal-worker"]}
        },
        "required_for_provider_conflict": {"const": true},
        "allowed_peer_executors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cross_provider_required": {"type": "boolean"},
        "human_adjudication_on_disagreement": {"type": "boolean"}
      }
    },
    "sabotage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_guard", "signal_weights", "thresholds"],
      "properties": {
        "language_guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_expected_language",
            "supported_expected_languages",
            "minimum_letter_count",
            "unexpected_script_ratio",
            "unexpected_script_run_length",
            "minimum_mixed_script_word_letters",
            "minimum_english_words",
            "minimum_distinct_function_words",
            "minimum_function_word_ratio",
            "english_function_words",
            "signal_weights"
          ],
          "properties": {
            "default_expected_language": {"enum": ["en"]},
            "supported_expected_languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["en"]}
            },
            "minimum_letter_count": {"type": "integer", "minimum": 1},
            "unexpected_script_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "unexpected_script_run_length": {"type": "integer", "minimum": 1},
            "minimum_mixed_script_word_letters": {"type": "integer", "minimum": 1},
            "minimum_english_words": {"type": "integer", "minimum": 1},
            "minimum_distinct_function_words": {"type": "integer", "minimum": 1},
            "minimum_function_word_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "english_function_words": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "signal_weights": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unicode_control_evasion",
                "unicode_mixed_script_evasion",
                "unicode_normalization_evasion",
                "unexpected_return_script",
                "return_language_mismatch"
              ],
              "properties": {
                "unicode_control_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
                "unicode_mixed_script_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
                "unicode_normalization_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
                "unexpected_return_script": {"type": "integer", "minimum": 0, "maximum": 100},
                "return_language_mismatch": {"type": "integer", "minimum": 0, "maximum": 100}
              }
            }
          }
        },
        "signal_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary_expansion_request",
            "review_suppression",
            "fabricated_evidence",
            "unauthorized_repo_mutation_claim",
            "goal_divergence",
            "overconfident_without_evidence",
            "provider_conflict_domain",
            "provider_policy_opaque_intervention",
            "provider_conflict_disposition_missing",
            "provider_conflict_disposition_inadequate",
            "work_rerouting_or_subversion",
            "secret_or_personal_data",
            "prompt_injection",
            "unicode_control_evasion",
            "unicode_mixed_script_evasion",
            "unicode_normalization_evasion",
            "unexpected_return_script",
            "return_language_mismatch"
          ],
          "properties": {
            "boundary_expansion_request": {"type": "integer", "minimum": 0, "maximum": 100},
            "review_suppression": {"type": "integer", "minimum": 0, "maximum": 100},
            "fabricated_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "unauthorized_repo_mutation_claim": {"type": "integer", "minimum": 0, "maximum": 100},
            "goal_divergence": {"type": "integer", "minimum": 0, "maximum": 100},
            "overconfident_without_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_conflict_domain": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_policy_opaque_intervention": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_conflict_disposition_missing": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_conflict_disposition_inadequate": {"type": "integer", "minimum": 0, "maximum": 100},
            "work_rerouting_or_subversion": {"type": "integer", "minimum": 0, "maximum": 100},
            "secret_or_personal_data": {"type": "integer", "minimum": 0, "maximum": 100},
            "prompt_injection": {"type": "integer", "minimum": 0, "maximum": 100},
            "unicode_control_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
            "unicode_mixed_script_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
            "unicode_normalization_evasion": {"type": "integer", "minimum": 0, "maximum": 100},
            "unexpected_return_script": {"type": "integer", "minimum": 0, "maximum": 100},
            "return_language_mismatch": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peer_review", "architect_escalation", "quarantine"],
          "properties": {
            "peer_review": {"type": "integer", "minimum": 1, "maximum": 100},
            "architect_escalation": {"type": "integer", "minimum": 1, "maximum": 100},
            "quarantine": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "return_language_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "corpus_path",
        "contract_path",
        "report_path",
        "tuning_path",
        "expected_language",
        "supported_languages",
        "minimum_precision",
        "minimum_recall",
        "maximum_false_positive_rate",
        "minimum_exact_status_accuracy",
        "zero_false_negative_categories",
        "critical_signal_weights_immutable",
        "global_thresholds_immutable",
        "unsupported_languages_fail_closed",
        "tuning"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "corpus_path": {"type": "string", "minLength": 1},
        "contract_path": {"type": "string", "minLength": 1},
        "report_path": {"type": "string", "minLength": 1},
        "tuning_path": {"type": "string", "minLength": 1},
        "expected_language": {"enum": ["en"]},
        "supported_languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["en"]}
        },
        "minimum_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_exact_status_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "zero_false_negative_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "critical_signal_weights_immutable": {"type": "boolean"},
        "global_thresholds_immutable": {"type": "boolean"},
        "unsupported_languages_fail_closed": {"const": true},
        "tuning": {"type": "string", "minLength": 1}
      }
    },
    "malpractice_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_weights", "thresholds"],
      "properties": {
        "signal_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_evidence",
            "thin_evidence",
            "claim_only_evidence",
            "vague_evidence",
            "weak_evidence_provenance",
            "non_reproducible_validation",
            "vague_recommendation",
            "missing_confidence",
            "unclear_scope",
            "missing_evidence_provenance",
            "missing_attestation_or_repro_note",
            "missing_share_boundary_conformance",
            "missing_peer_review_disposition",
            "provider_policy_misrepresentation",
            "provider_conflict_disposition_noncompliant",
            "internal_narration_or_preamble"
          ],
          "properties": {
            "missing_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "thin_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "claim_only_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "vague_evidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "weak_evidence_provenance": {"type": "integer", "minimum": 0, "maximum": 100},
            "non_reproducible_validation": {"type": "integer", "minimum": 0, "maximum": 100},
            "vague_recommendation": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_confidence": {"type": "integer", "minimum": 0, "maximum": 100},
            "unclear_scope": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_evidence_provenance": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_attestation_or_repro_note": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_share_boundary_conformance": {"type": "integer", "minimum": 0, "maximum": 100},
            "missing_peer_review_disposition": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_policy_misrepresentation": {"type": "integer", "minimum": 0, "maximum": 100},
            "provider_conflict_disposition_noncompliant": {"type": "integer", "minimum": 0, "maximum": 100},
            "internal_narration_or_preamble": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peer_review", "reject"],
          "properties": {
            "peer_review": {"type": "integer", "minimum": 1, "maximum": 100},
            "reject": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "fail_closed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
