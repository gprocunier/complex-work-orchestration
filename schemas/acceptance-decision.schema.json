{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance Decision",
  "type": "object",
  "required": ["dispatch_id", "bead_id", "verdict", "score", "architect_review_required"],
  "properties": {
    "dispatch_id": {"type": ["string", "null"]},
    "bead_id": {"type": ["string", "null"]},
    "executor": {"type": ["string", "null"]},
    "provider_key": {"type": ["string", "null"]},
    "provider_trust_tier": {"type": ["string", "null"]},
    "provider_family": {"type": ["string", "null"]},
    "provider_retention_class": {"type": ["string", "null"]},
    "provider_external": {"type": ["boolean", "null"]},
    "dispatch_mode": {"type": ["string", "null"]},
    "local_profile": {"type": ["string", "null"]},
    "provenance_class": {"enum": ["local-worker", "external-contractor", "internal", "unknown"]},
    "provenance_warnings": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["accept", "clarify", "partial-accept", "reject", "escalate", "quarantine"]},
    "score": {"type": "integer"},
    "evaluator_scoring_final": {"type": "boolean"},
    "architect_review_required": {"type": "boolean"},
    "architect_adjudication_required": {"type": "boolean"},
    "architect_signoff": {"type": "boolean"},
    "accepted_findings": {"type": "array", "items": {"type": "string"}},
    "rejected_findings": {"type": "array", "items": {"type": "string"}},
    "clarification_required": {"type": "array", "items": {"type": "string"}},
    "missing_sections": {"type": "array", "items": {"type": "string"}},
    "penalty_reasons": {"type": "array", "items": {"type": "string"}},
    "hard_disqualifiers": {"type": "array", "items": {"type": "string"}},
    "sabotage_score": {"type": "integer"},
    "sabotage_signals": {"type": "array", "items": {"type": "object"}},
    "sabotage_signal_categories": {"type": "array", "items": {"type": "string"}},
    "sabotage_review_recommended": {"type": "boolean"},
    "sabotage_architect_escalation_recommended": {"type": "boolean"},
    "evidence_quality_score": {"type": "integer"},
    "evidence_quality_signals": {"type": "array", "items": {"type": "object"}},
    "evidence_quality_signal_categories": {"type": "array", "items": {"type": "string"}},
    "malpractice_score": {"type": "integer"},
    "malpractice_signals": {"type": "array", "items": {"type": "object"}},
    "malpractice_signal_categories": {"type": "array", "items": {"type": "string"}},
    "malpractice_review_recommended": {"type": "boolean"},
    "malpractice_reject_recommended": {"type": "boolean"},
    "signal_categories": {"type": "array", "items": {"type": "string"}},
    "peer_review_required": {"type": "boolean"},
    "peer_review_status": {"enum": ["not-run", "pending", "passed", "failed", "disagreement", "blocked"]},
    "patch_authorization_state": {"enum": ["explicit-allow", "explicit-deny", "proposal-only", "ambiguous", "absent"]},
    "provider_conflict_domains": {"type": "array", "items": {"type": "string"}},
    "boundary_taint_status": {"enum": ["clear", "boundary-tainted", "not-applicable"]},
    "boundary_taint_findings": {"type": "array", "items": {"type": "string"}},
    "workspace_mutation": {"type": ["object", "null"]},
    "human_adjudication_required": {"type": "boolean"},
    "recommended_disposition": {"type": "string"},
    "recommended_synthesis_use": {
      "enum": ["primary", "salvage-only", "open-risk", "partial-only", "reject", "quarantine", "unknown"]
    },
    "quarantine_recommended": {"type": "boolean"},
    "escalation_flagged": {"type": "boolean"},
    "sections": {"type": "object"},
    "followup_beads": {"type": "array", "items": {"type": "string"}}
  }
}
