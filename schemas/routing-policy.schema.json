{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwo:policy/routing-policy:v2",
  "title": "CWO Routing Policy",
  "description": "Whole-document schema for policy/routing-policy.yaml version 2, checked by cwo_core.policy_schema whenever the policy is loaded. It uses only the bounded keyword subset that cwo_core.policy_schema supports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema",
    "defaults",
    "route_classes",
    "scoring",
    "restricted_terms",
    "sensitivity_terms",
    "local_worker",
    "external_contract_guard_labels",
    "architect_review_required_for",
    "hard_stops"
  ],
  "properties": {
    "version": {"const": 2},
    "schema": {"const": "json-compatible-yaml"},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "share_boundary",
        "task_class",
        "risk_level",
        "data_sensitivity",
        "recommended_executor",
        "beads_required_for_full_handoff",
        "top_n_experts",
        "top_n_executors"
      ],
      "properties": {
        "share_boundary": {"enum": ["no-outside-sharing", "redacted-packet", "repo-readonly", "patch-branch"]},
        "task_class": {"type": "string", "minLength": 1},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "data_sensitivity": {"enum": ["public", "redacted", "internal", "restricted"]},
        "recommended_executor": {"type": "string", "minLength": 1},
        "beads_required_for_full_handoff": {"type": "boolean"},
        "top_n_experts": {"type": "integer", "minimum": 1, "maximum": 100},
        "top_n_executors": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "route_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in-thread", "internal-worker", "local-worker", "architect-review", "external-contract"],
      "properties": {
        "in-thread": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1}
          }
        },
        "internal-worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1}
          }
        },
        "local-worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1}
          }
        },
        "architect-review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1}
          }
        },
        "external-contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expert", "executor"],
      "properties": {
        "expert": {
          "type": "object",
          "additionalProperties": false,
          "required": ["explicit_role", "path_match", "trigger_term", "stage_match", "component_match"],
          "properties": {
            "explicit_role": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "path_match": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "trigger_term": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "stage_match": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "component_match": {"type": "integer", "minimum": -1000, "maximum": 1000}
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_class_fit",
            "tooling_fit",
            "privacy_fit",
            "evidence_fit",
            "latency_fit",
            "cost_fit",
            "prefer_local_fit",
            "policy_violation",
            "missing_user_opt_in",
            "manual_dispatch_penalty_when_unattended"
          ],
          "properties": {
            "task_class_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "tooling_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "privacy_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "evidence_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "latency_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "cost_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "prefer_local_fit": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "policy_violation": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "missing_user_opt_in": {"type": "integer", "minimum": -1000, "maximum": 1000},
            "manual_dispatch_penalty_when_unattended": {"type": "integer", "minimum": -1000, "maximum": 1000}
          }
        }
      }
    },
    "restricted_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sensitivity_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restricted", "redacted", "public"],
      "properties": {
        "restricted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "redacted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "public": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "local_worker": {
      "description": "An empty allowed list would let routing skip the check, so each list needs at least one entry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_risks", "allowed_task_classes", "requires_acceptance"],
      "properties": {
        "allowed_risks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["low", "medium", "high", "critical"]}
        },
        "allowed_task_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "requires_acceptance": {"const": true}
      }
    },
    "external_contract_guard_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "architect_review_required_for": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "in-thread",
          "internal-worker",
          "local-worker",
          "architect-review",
          "external-contract",
          "low",
          "medium",
          "high",
          "critical"
        ]
      }
    },
    "hard_stops": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
