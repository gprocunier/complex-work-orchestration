{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Pool Transaction Readiness",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "readiness_type": {
      "const": "cwo-native-pool-transaction-readiness"
    },
    "version": {
      "const": 1
    },
    "schema": {
      "const": "schemas/native-pool-transaction-readiness.schema.json"
    },
    "readiness_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parent_readiness_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "bead_projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "child_id": {
            "type": "string",
            "minLength": 1
          },
          "bead_id": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "type": "object"
          },
          "projection_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "child_id",
          "bead_id",
          "projection",
          "projection_sha256"
        ]
      }
    },
    "packet_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "child_id": {
            "type": "string",
            "minLength": 1
          },
          "packet_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "precommit_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "work_plan_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "child_id",
          "packet_sha256",
          "precommit_receipt_sha256",
          "work_plan_sha256"
        ]
      }
    },
    "release_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "child_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "child_id",
          "kind",
          "evidence_sha256",
          "issued_at",
          "expires_at"
        ]
      }
    },
    "earliest_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "required_lifetime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "available_lifetime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "valid_through": {
      "type": "string",
      "format": "date-time"
    },
    "readiness_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "readiness_type",
    "version",
    "schema",
    "readiness_id",
    "plan_sha256",
    "parent_readiness_sha256",
    "created_at",
    "bead_projections",
    "packet_bindings",
    "release_dependencies",
    "earliest_expires_at",
    "required_lifetime_ms",
    "available_lifetime_ms",
    "valid_through",
    "readiness_sha256"
  ]
}
