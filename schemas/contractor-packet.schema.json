{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contractor Packet",
  "type": "object",
  "required": ["dispatch_id", "generated_at", "bead_id", "executor", "provider_key", "provider_trust_tier", "share_boundary", "disclosure_stage", "disclosure_escalation_approved", "job_description_label", "expert_profile_included", "degraded_context_justification", "external_opt_in", "opt_in_basis", "boundary_description", "bead_summary", "selected_snippets", "included_artifacts", "excluded_artifacts", "required_return_sections", "acceptance_rule", "quota_checked", "packet_sha256"],
  "allOf": [
    {
      "if": {"properties": {"packet_version": {"minimum": 2}}, "required": ["packet_version"]},
      "then": {"required": ["expected_return_language"]}
    }
  ],
  "properties": {
    "dispatch_id": {"type": "string"},
    "packet_version": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string"},
    "bead_id": {"type": "string"},
    "epic_id": {"type": ["string", "null"]},
    "executor": {"type": "string"},
    "provider_key": {"type": "string"},
    "provider_family": {"type": ["string", "null"]},
    "provider_trust_tier": {"type": "string"},
    "provider_retention_class": {"type": ["string", "null"]},
    "share_boundary": {"type": "string"},
    "disclosure_stage": {"enum": ["none", "redacted", "repo-readonly", "patch-branch"]},
    "disclosure_escalation_approved": {"type": "boolean"},
    "job_description_label": {"type": "string"},
    "expected_return_language": {"enum": ["en"]},
    "expert_profile": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256", "content"],
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string"},
            "content": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "expert_profile_included": {"type": "boolean"},
    "degraded_context_justification": {"type": "string"},
    "external_opt_in": {"type": "boolean"},
    "opt_in_basis": {"enum": ["cli-flag", "audit-record", "manual-note", "not-recorded"]},
    "boundary_description": {"type": "string"},
    "bead_summary": {"type": "object"},
    "selected_snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "line_count", "truncated", "sha256", "content"],
        "properties": {
          "type": {"enum": ["selected_file_snippet", "inline_snippet"]},
          "path": {"type": "string"},
          "line_count": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "sha256": {"type": "string"},
          "content": {"type": "string"}
        }
      }
    },
    "included_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "sha256"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string"},
          "line_count": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"},
          "sha256": {"type": "string"}
        }
      }
    },
    "excluded_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reason"],
        "properties": {
          "type": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "review_surface_contract": {
      "type": "object",
      "properties": {
        "review_surface": {"type": "string"},
        "source_inspection": {"type": "string"},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}},
        "go_rule": {"type": "string"},
        "required_disclosures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "required_return_sections": {"type": "array", "items": {"type": "string"}},
    "acceptance_rule": {"type": "string"},
    "quota_checked": {"type": "boolean"},
    "quota_event_type": {"type": ["string", "null"]},
    "quota_limit": {"type": ["integer", "null"]},
    "quota_remaining": {"type": ["integer", "null"]},
    "packet_sha256": {"type": "string"}
  }
}
