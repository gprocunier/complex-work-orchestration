{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/native-worker-commitment.schema.json",
  "title": "cwo-native-worker-fit-commitment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commitment_type": {"const": "cwo-native-worker-fit-commitment"},
    "version": {"type": "integer", "enum": [1, 2]},
    "packet_id": {"type": "string", "minLength": 1},
    "attempt_nonce": {"type": "string", "minLength": 1},
    "work_unit_id": {"type": "string", "minLength": 1},
    "bead_id": {"type": "string", "minLength": 1},
    "requested_model": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "attestation_source": {"type": "string", "minLength": 1},
    "attested_model": {"type": "string", "minLength": 1},
    "work_estimate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["accept", "pm-realignment", "architect-realignment"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_calls_p50": {"type": "integer", "minimum": 1},
        "tool_calls_p90": {"type": "integer", "minimum": 1},
        "runtime_seconds_p50": {"type": "integer", "minimum": 1},
        "runtime_seconds_p90": {"type": "integer", "minimum": 1}
      },
      "required": ["tool_calls_p50", "tool_calls_p90", "runtime_seconds_p50", "runtime_seconds_p90"]
    },
    "tool_calls_before_commitment": {"const": 0},
    "context_compactions_before_commitment": {"const": 0},
    "reason": {"type": "string", "minLength": 1},
    "precommit_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "commitment_type", "version", "work_unit_id", "bead_id", "requested_model",
    "session_id", "attestation_source", "attested_model", "work_estimate_sha256",
    "decision", "estimates"
  ],
  "allOf": [
    {
      "if": {"properties": {"version": {"const": 1}}, "required": ["version"]},
      "then": {
        "required": ["confidence", "tool_calls_before_commitment", "context_compactions_before_commitment", "reason"],
        "not": {"anyOf": [{"required": ["packet_id"]}, {"required": ["attempt_nonce"]}, {"required": ["agent_id"]}, {"required": ["precommit_receipt_sha256"]}]}
      }
    },
    {
      "if": {"properties": {"version": {"const": 2}}, "required": ["version"]},
      "then": {
        "required": ["packet_id", "attempt_nonce", "agent_id", "precommit_receipt_sha256"],
        "not": {"anyOf": [{"required": ["confidence"]}, {"required": ["tool_calls_before_commitment"]}, {"required": ["context_compactions_before_commitment"]}, {"required": ["reason"]}]}
      }
    }
  ],
  "$comment": "Version 1 is historical-inspection-only. Version 2 derives identity, model, activity authority, and fit values from the embedded validated precommit receipt."
}
