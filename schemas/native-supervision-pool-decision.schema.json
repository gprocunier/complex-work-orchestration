{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Supervision Pool Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_type", "version", "schema", "pool_id", "pool_epoch", "contract_sha256",
    "state_sha256", "decision_sequence", "decision", "selected_child_id", "deadlines",
    "observed_callback_latency_ms", "aggregate_usage", "reasons", "reason_records",
    "required_control_actions", "stop_scope", "authorized_continuation_paths",
    "scope_authority", "decision_sha256"
  ],
  "properties": {
    "decision_type": {"const": "cwo-native-supervision-pool-decision"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-supervision-pool-decision.schema.json"},
    "pool_id": {"type": "string", "minLength": 1},
    "pool_epoch": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "state_sha256": {"$ref": "#/$defs/sha256"},
    "decision_sequence": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["continue", "warn", "complete", "interrupt", "control-lost"]},
    "selected_child_id": {"type": ["string", "null"], "minLength": 1},
    "deadlines": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["child_id", "next_deadline_ns"],
        "properties": {
          "child_id": {"type": "string", "minLength": 1},
          "next_deadline_ns": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "observed_callback_latency_ms": {"type": ["number", "null"], "minimum": 0},
    "aggregate_usage": {"$ref": "#/$defs/usage"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason_records": {"type": "array", "items": {"$ref": "#/$defs/reason_record"}},
    "required_control_actions": {
      "type": "array",
      "items": {"enum": ["admit", "step", "interrupt", "close", "finalize", "release-leases"]}
    },
    "stop_scope": {"$ref": "#/$defs/stop_scope"},
    "authorized_continuation_paths": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/continuation_path"}
    },
    "scope_authority": {"$ref": "#/$defs/scope_authority"},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["availability", "input", "cached_input", "output", "reasoning", "total", "unavailable_reason"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "input": {"type": ["integer", "null"], "minimum": 0},
        "cached_input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "unavailable_reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_calls", "runtime_seconds", "compactions", "full_suite_runs", "mutations", "tokens"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": "integer", "minimum": 0},
        "compactions": {"type": "integer", "minimum": 0},
        "full_suite_runs": {"type": "integer", "minimum": 0},
        "mutations": {"type": "integer", "minimum": 0},
        "tokens": {"$ref": "#/$defs/tokens"}
      }
    },
    "stop_scope": {
      "enum": ["child", "cohort", "execution-path", "complete-task", "publication"]
    },
    "continuation_path": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "target_id", "conditions"],
      "properties": {
        "path": {"enum": ["retry-child", "replace-child", "continue-cohort", "retry-cohort", "alternate-execution-path", "resume-task", "task-remediation", "publication-review", "operator-adjudication"]},
        "target_id": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source_type", "source_id", "source_sha256", "actor_id", "actor_role", "identity_source", "authorized_scope", "parent_receipt_sha256", "verification", "authority_sha256"],
      "properties": {
        "version": {"const": 1},
        "source_type": {"enum": ["worker-discovery", "pm-observation", "architect-judgment", "operator-directive", "policy-enforcement"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["operative-worker", "critic", "project-manager", "architect", "supervisor-policy", "operator"]},
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {"$ref": "#/$defs/stop_scope"},
        "parent_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_record": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "authority_provenance", "detected_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "authority_provenance": {"$ref": "#/$defs/scope_authority"},
        "detected_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
