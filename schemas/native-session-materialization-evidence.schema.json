{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/native-session-materialization-evidence.schema.json",
  "title": "CWO native session materialization evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_type",
    "version",
    "schema",
    "evidence_id",
    "run_nonce",
    "attempt_nonce",
    "phase_nonce",
    "session_id",
    "thread_id",
    "turn_id",
    "requested_model",
    "attested_model",
    "attested_effort",
    "attestation_source",
    "connection_epoch_sha256",
    "command_sha256",
    "session_source_identity_sha256",
    "baseline",
    "control_observations",
    "liveness_observations",
    "pre_interrupt_observation",
    "notification_shape",
    "terminal_execution_correlation",
    "interrupt",
    "terminal",
    "terminal_event",
    "status",
    "disposition",
    "evidence_sha256"
  ],
  "properties": {
    "evidence_type": {"const": "cwo-native-session-materialization-evidence:v5"},
    "version": {"const": 5},
    "schema": {"const": "schemas/native-session-materialization-evidence.schema.json"},
    "evidence_id": {"type": "string", "minLength": 1},
    "run_nonce": {"$ref": "#/$defs/uuid"},
    "attempt_nonce": {"$ref": "#/$defs/uuid"},
    "phase_nonce": {"$ref": "#/$defs/uuid"},
    "session_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "requested_model": {"type": "string", "minLength": 1},
    "attested_model": {"type": "string", "minLength": 1},
    "attested_effort": {"type": "string", "minLength": 1},
    "attestation_source": {"type": "string", "minLength": 1},
    "connection_epoch_sha256": {"$ref": "#/$defs/hash"},
    "command_sha256": {"$ref": "#/$defs/hash"},
    "session_source_identity_sha256": {"$ref": "#/$defs/hash"},
    "baseline": {"$ref": "#/$defs/boundary"},
    "control_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 192,
      "items": {"$ref": "#/$defs/controlObservation"}
    },
    "liveness_observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/observation"}
    },
    "pre_interrupt_observation": {"$ref": "#/$defs/observation"},
    "notification_shape": {"$ref": "#/$defs/notificationShape"},
    "terminal_execution_correlation": {"$ref": "#/$defs/terminalExecutionCorrelation"},
    "interrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "request_accepted_at",
        "confirmed_at",
        "session_id",
        "thread_id",
        "turn_id",
        "request_outcome",
        "outcome"
      ],
      "properties": {
        "requested_at": {"type": "string", "format": "date-time"},
        "request_accepted_at": {"type": "string", "format": "date-time"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "session_id": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1},
        "turn_id": {"type": "string", "minLength": 1},
        "request_outcome": {"const": "accepted"},
        "outcome": {"const": "interrupt-confirmed"}
      }
    },
    "terminal": {"$ref": "#/$defs/boundary"},
    "terminal_event": {"$ref": "#/$defs/terminalEvent"},
    "status": {"enum": ["interrupt-confirmed", "nonaccepting"]},
    "disposition": {"enum": ["accepted", "quarantined", "rejected"]},
    "evidence_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "byte_offset",
        "boundary_sha256",
        "invalid_record_count",
        "trailing_partial"
      ],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "byte_offset": {"type": "integer", "minimum": 0},
        "boundary_sha256": {"$ref": "#/$defs/hash"},
        "invalid_record_count": {"const": 0},
        "trailing_partial": {"const": false}
      }
    },
    "controlObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "elapsed_monotonic_ms",
        "phase",
        "projected_status",
        "durable_status",
        "source_identity_sha256",
        "previous_boundary_sha256",
        "boundary",
        "decision"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "elapsed_monotonic_ms": {"type": "number", "minimum": 0},
        "phase": {
          "enum": ["materialization", "pre-interrupt", "interrupt-confirmation", "terminal"]
        },
        "projected_status": {
          "enum": ["active", "completed", "failed", "interrupted", "missing", "unknown"]
        },
        "durable_status": {
          "type": ["string", "null"],
          "enum": [null, "completed", "failed", "interrupted"]
        },
        "source_identity_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/hash"},
            {"type": "null"}
          ]
        },
        "previous_boundary_sha256": {"$ref": "#/$defs/hash"},
        "boundary": {"$ref": "#/$defs/boundary"},
        "decision": {
          "enum": [
            "continue-pending",
            "continue-active",
            "continue-provisional",
            "ready",
            "interrupt-pending",
            "interrupt-confirmed",
            "terminal-accepted"
          ]
        }
      }
    },
    "terminalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_index", "event_type", "status", "count"],
      "properties": {
        "record_index": {"type": "integer", "minimum": 0},
        "event_type": {"const": "turn_aborted"},
        "status": {"const": "interrupted"},
        "count": {"const": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "boundary",
        "session_source_identity_sha256",
        "connection_epoch_sha256",
        "notification_sequence",
        "notification_received_monotonic_ns",
        "notification_started_at_ms",
        "turn_context_record_index",
        "function_call_record_index",
        "command_item_id_sha256",
        "function_call_id_sha256",
        "rendered_command_sha256",
        "execution_correlation_sha256",
        "correlation_mode",
        "notification_command_semantic_match",
        "notification_workspace_match",
        "command_source",
        "command_status",
        "started_event_count",
        "function_call_count",
        "completed_event_count",
        "paired_result_count",
        "competing_call_count",
        "terminal_event_count",
        "failed_event_count",
        "declined_event_count",
        "ambiguous_event_count"
      ],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "boundary": {"$ref": "#/$defs/boundary"},
        "session_source_identity_sha256": {"$ref": "#/$defs/hash"},
        "connection_epoch_sha256": {"$ref": "#/$defs/hash"},
        "notification_sequence": {"type": "integer", "minimum": 1},
        "notification_received_monotonic_ns": {"type": "integer", "minimum": 0},
        "notification_started_at_ms": {"type": "integer", "minimum": 0},
        "turn_context_record_index": {"type": ["integer", "null"], "minimum": 0},
        "function_call_record_index": {"type": ["integer", "null"], "minimum": 0},
        "command_item_id_sha256": {"$ref": "#/$defs/hash"},
        "function_call_id_sha256": {
          "anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "rendered_command_sha256": {"$ref": "#/$defs/hash"},
        "execution_correlation_sha256": {"$ref": "#/$defs/hash"},
        "correlation_mode": {
          "enum": ["session-and-notification", "notification-first"]
        },
        "notification_command_semantic_match": {"const": true},
        "notification_workspace_match": {"const": true},
        "command_source": {
          "enum": ["unifiedExecStartup", "namespacedExecStartup"]
        },
        "command_status": {"const": "inProgress"},
        "started_event_count": {"const": 1},
        "function_call_count": {"enum": [0, 1]},
        "completed_event_count": {"const": 0},
        "paired_result_count": {"const": 0},
        "competing_call_count": {"const": 0},
        "terminal_event_count": {"const": 0},
        "failed_event_count": {"const": 0},
        "declined_event_count": {"const": 0},
        "ambiguous_event_count": {"const": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"correlation_mode": {"const": "notification-first"}}},
          "then": {
            "properties": {
              "turn_context_record_index": {"type": "null"},
              "function_call_record_index": {"type": "null"},
              "function_call_id_sha256": {"type": "null"},
              "function_call_count": {"const": 0}
            }
          },
          "else": {
            "properties": {
              "turn_context_record_index": {"type": "integer", "minimum": 0},
              "function_call_record_index": {"type": "integer", "minimum": 0},
              "function_call_id_sha256": {"$ref": "#/$defs/hash"},
              "function_call_count": {"const": 1}
            }
          }
        }
      ]
    },
    "terminalExecutionCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_context_record_index",
        "function_call_record_index",
        "function_call_id_sha256",
        "command_item_id_sha256",
        "notification_sequence",
        "notification_received_monotonic_ns",
        "notification_started_at_ms",
        "rendered_command_sha256",
        "execution_correlation_sha256"
      ],
      "properties": {
        "turn_context_record_index": {"type": "integer", "minimum": 0},
        "function_call_record_index": {"type": "integer", "minimum": 0},
        "function_call_id_sha256": {"$ref": "#/$defs/hash"},
        "command_item_id_sha256": {"$ref": "#/$defs/hash"},
        "notification_sequence": {"type": "integer", "minimum": 1},
        "notification_received_monotonic_ns": {"type": "integer", "minimum": 0},
        "notification_started_at_ms": {"type": "integer", "minimum": 0},
        "rendered_command_sha256": {"$ref": "#/$defs/hash"},
        "execution_correlation_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "notificationShapeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "received_monotonic_ns",
        "method",
        "params_keys",
        "item_keys",
        "thread_id_matches",
        "turn_id_matches",
        "item_type",
        "item_status",
        "item_namespace",
        "item_tool",
        "item_id_sha256",
        "payload_digest_sha256",
        "started_at_ms_type"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "received_monotonic_ns": {"type": "integer", "minimum": 0},
        "method": {"type": "string", "minLength": 1},
        "params_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "item_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "thread_id_matches": {"const": true},
        "turn_id_matches": {"const": true},
        "item_type": {"type": "string", "minLength": 1},
        "item_status": {"type": "string", "minLength": 1},
        "item_namespace": {"type": ["string", "null"]},
        "item_tool": {"type": ["string", "null"]},
        "item_id_sha256": {"$ref": "#/$defs/hash"},
        "payload_digest_sha256": {"$ref": "#/$defs/hash"},
        "started_at_ms_type": {"enum": ["integer", "missing"]}
      }
    },
    "notificationShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "version",
        "connection_epoch_sha256",
        "thread_id_sha256",
        "turn_id_sha256",
        "event_count",
        "events",
        "evidence_sha256"
      ],
      "properties": {
        "evidence_type": {"const": "cwo-app-server-notification-shape:v1"},
        "version": {"const": 1},
        "connection_epoch_sha256": {"$ref": "#/$defs/hash"},
        "thread_id_sha256": {"$ref": "#/$defs/hash"},
        "turn_id_sha256": {"$ref": "#/$defs/hash"},
        "event_count": {"type": "integer", "minimum": 1},
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/notificationShapeEvent"}
        },
        "evidence_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
