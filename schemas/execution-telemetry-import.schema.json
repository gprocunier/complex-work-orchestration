{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Execution Telemetry Import Sidecar",
  "oneOf": [
    {"$ref": "#/$defs/record"},
    {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    },
    {
      "type": "object",
      "required": ["records"],
      "properties": {
        "source_label": {"type": "string"},
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/record"}
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "anyOf": [
        {"required": ["dispatch_id"]},
        {"required": ["bead_id"]}
      ],
      "properties": {
        "dispatch_id": {"type": "string"},
        "bead_id": {"type": "string"},
        "executor": {"type": "string"},
        "executor_key": {"type": "string"},
        "provider": {"type": "string"},
        "provider_key": {"type": "string"},
        "provider_family": {"type": "string"},
        "provider_retention_class": {"type": "string"},
        "model": {"type": "string"},
        "model_label": {"type": "string"},
        "job_description_label": {"type": "string"},
        "expected_return_language": {"type": "string"},
        "expected_return_language_source": {"type": "string"},
        "return_language_status": {"type": "string"},
        "return_language_finding_count": {"type": "number", "minimum": 0},
        "epic_id": {"type": ["string", "null"]},
        "work_unit_id": {"type": ["string", "null"]},
        "packet_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "phase": {"type": ["string", "null"]},
        "event": {"type": ["string", "null"]},
        "call_category": {"type": ["string", "null"], "enum": ["productive","validation","attestation","fit","monitoring","recovery","pm","architect","unknown", null]},
        "detected_letter_scripts": {"type": "array", "items": {"type": "string"}},
        "unexpected_script_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "unicode_normalization_changed": {"type": "boolean"},
        "expert_profile": {"type": "string"},
        "expert_profile_path": {"type": "string"},
        "workerbee_planned_delegation": {
          "type": "object",
          "properties": {
            "mode": {"type": "string"},
            "model": {"type": ["string", "null"]},
            "lanes": {"type": "array", "items": {"type": "string"}},
            "recommended_mode": {"type": "string"},
            "recommended_model": {"type": ["string", "null"]},
            "suggested_lanes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "telemetry_missing_reason": {"type": "string"},
        "telemetry_missing_reasons": {"type": "array", "items": {"type": "string"}},
        "telemetry_source": {"type": "string"},
        "workerbee_planned_mode": {"type": "string"},
        "workerbee_planned_model": {"type": "string"},
        "workerbee_planned_lanes": {"type": "array", "items": {"type": "string"}},
        "workerbee_actual_mode": {"type": "string"},
        "workerbee_actual_model": {"type": "string"},
        "workerbee_actual_lanes": {"type": "array", "items": {"type": "string"}},
        "workerbee_delegation_status": {"type": "string"},
        "workerbee_delegation_source": {"type": "string"},
        "requested_model": {"type": "string"},
        "actual_model": {"type": "string"},
        "workerbee_delegation_gap_reasons": {"type": "array", "items": {"type": "string"}},
        "agent_model_calls": {"type": "number", "minimum": 0},
        "retry_count": {"type": "number", "minimum": 0},
        "retries": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "total_tokens": {"type": "number", "minimum": 0},
        "active_seconds": {"type": "number", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "usage": {
          "type": "object",
          "properties": {
            "input": {"type": "number", "minimum": 0},
            "input_tokens": {"type": "number", "minimum": 0},
            "prompt_tokens": {"type": "number", "minimum": 0},
            "cached_tokens": {"type": "number", "minimum": 0},
            "output": {"type": "number", "minimum": 0},
            "output_tokens": {"type": "number", "minimum": 0},
            "completion_tokens": {"type": "number", "minimum": 0},
            "reasoning_tokens": {"type": "number", "minimum": 0},
            "total": {"type": "number", "minimum": 0},
            "total_tokens": {"type": "number", "minimum": 0},
            "tool_calls": {"type": ["integer", "null"], "minimum": 0},
            "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
            "context_compactions": {"type": ["integer", "null"], "minimum": 0},
            "full_suite_runs": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "graph_counters": {
          "type": "object",
          "properties": {
            "beads_total": {"type": ["integer", "null"], "minimum": 0},
            "beads_open": {"type": ["integer", "null"], "minimum": 0},
            "beads_closed": {"type": ["integer", "null"], "minimum": 0},
            "graph_depth": {"type": ["integer", "null"], "minimum": 0},
            "work_units_total": {"type": ["integer", "null"], "minimum": 0},
            "work_units_open": {"type": ["integer", "null"], "minimum": 0},
            "work_units_closed": {"type": ["integer", "null"], "minimum": 0},
            "routine_repair_children": {"type": ["integer", "null"], "minimum": 0},
            "worker_sessions": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
