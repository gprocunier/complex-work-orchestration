{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Worker Return",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "needsReplan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "hidden-coupling",
            "scope-growth",
            "unexpected-reasoning",
            "decision-uncertainty",
            "environment"
          ]
        },
        "completed_evidence": {"type": "string", "minLength": 1},
        "discovered_facts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "files_touched": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "mutation_state": {
          "type": "string",
          "enum": ["clean", "modified", "committed", "unknown"]
        },
        "mutation_stopped": {"const": true},
        "remaining_outcomes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "remaining_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "remaining_tests": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class": {"type": "string", "enum": ["bounded", "material", "architect"]},
            "decision": {
              "type": "string",
              "enum": ["pm-refine", "architect-reasoning", "reassign-spark"]
            },
            "detail": {"type": "string", "minLength": 1}
          },
          "required": ["class", "decision", "detail"]
        },
        "scope_delta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcomes_added": {"type": "integer", "minimum": 0},
            "files_added": {"type": "integer", "minimum": 0},
            "tests_added": {"type": "integer", "minimum": 0},
            "within_original_objective": {"type": "boolean"},
            "within_aggregate_allowance": {"type": "boolean"}
          },
          "required": [
            "outcomes_added",
            "files_added",
            "tests_added",
            "within_original_objective",
            "within_aggregate_allowance"
          ]
        },
        "bounded_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "option_id": {"type": "string", "minLength": 1},
              "route": {
                "type": "string",
                "enum": ["pm-refine", "architect-reasoning", "reassign-spark", "protected-stop"]
              },
              "description": {"type": "string", "minLength": 1},
              "tool_calls_p90": {"type": "integer", "minimum": 0},
              "runtime_seconds_p90": {"type": "integer", "minimum": 0}
            },
            "required": ["option_id", "route", "description", "tool_calls_p90", "runtime_seconds_p90"]
          }
        },
        "recommendation": {"type": "string", "minLength": 1},
        "cumulative_usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_calls": {"type": "integer", "minimum": 0},
            "runtime_seconds": {"type": "integer", "minimum": 0},
            "context_compactions": {"type": "integer", "minimum": 0},
            "full_suite_runs": {"type": "integer", "minimum": 0}
          },
          "required": ["tool_calls", "runtime_seconds", "context_compactions", "full_suite_runs"]
        }
      },
      "required": [
        "reason_code",
        "completed_evidence",
        "discovered_facts",
        "files_touched",
        "mutation_state",
        "mutation_stopped",
        "remaining_outcomes",
        "remaining_files",
        "remaining_tests",
        "uncertainty",
        "scope_delta",
        "bounded_options",
        "recommendation",
        "cumulative_usage"
      ]
    }
  },
  "required": [
    "return_type",
    "version",
    "packet_id",
    "bead_id",
    "session_id",
    "segment_id",
    "status",
    "requested_model",
    "actual_model",
    "attestation_source",
    "attestation_status",
    "completed_evidence",
    "files_touched",
    "mutation_state",
    "commands_run",
    "validation",
    "decision_required",
    "bounded_options",
    "recommendation",
    "remaining_scope",
    "usage",
    "residual_risks"
  ],
  "properties": {
    "return_type": {
      "type": "string",
      "const": "cwo-native-worker-return"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "bead_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "needs-replan",
        "needs-architect-realignment",
        "budget-exhausted",
        "model-mismatch"
      ]
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "actual_model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attestation_source": {
      "type": "string",
      "minLength": 1
    },
    "attestation_status": {
      "type": "string",
      "enum": [
        "trusted",
        "missing",
        "mismatch",
        "untrusted",
        "denied"
      ]
    },
    "completed_evidence": {
      "type": "string",
      "minLength": 1
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mutation_state": {
      "type": "string",
      "enum": [
        "clean",
        "modified",
        "committed",
        "unknown"
      ]
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    },
    "decision_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bounded_options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "type": "string"
    },
    "remaining_scope": {
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "elapsed_seconds",
        "context_compactions",
        "full_suite_runs"
      ],
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "context_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "full_suite_runs": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replan": {
      "$ref": "#/$defs/needsReplan"
    },
    "session_disposition": {
      "type": "string",
      "enum": ["accepted", "accepted-with-warning", "quarantined"]
    },
    "artifact_disposition": {
      "type": "string",
      "enum": ["accepted", "independent-validation-required", "architect-adjudication-required", "rejected"]
    },
    "artifact_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "max_attempts", "attempts_used", "outcome", "reason"],
      "properties": {
        "eligible": {"type": "boolean"},
        "max_attempts": {"type": "integer", "const": 1},
        "attempts_used": {"type": "integer", "minimum": 0, "maximum": 1},
        "outcome": {"type": "string", "enum": ["not-run", "passed", "failed"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["completed", "needs-replan"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "requested_model": {
            "enum": ["gpt-5.3-codex-spark", "gpt-5.6-luna"]
          },
          "actual_model": {
            "enum": ["gpt-5.3-codex-spark", "gpt-5.6-luna"]
          },
          "attestation_status": {
            "const": "trusted"
          },
          "attestation_source": {
            "const": "trusted-control-plane-session-metadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs-replan",
              "needs-architect-realignment",
              "budget-exhausted",
              "model-mismatch"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision_required": {
            "type": "array",
            "minItems": 1
          },
          "bounded_options": {
            "type": "array",
            "minItems": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "remaining_scope": {
            "type": "object",
            "minProperties": 1
          }
        },
        "required": [
          "decision_required",
          "bounded_options",
          "recommendation",
          "remaining_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "needs-replan"}},
        "required": ["status"]
      },
      "then": {
        "required": ["replan"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "model-mismatch"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "actual_model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["completed", "needs-replan"]},
          "requested_model": {"const": "gpt-5.3-codex-spark"}
        },
        "required": ["status", "requested_model"]
      },
      "then": {
        "properties": {
          "actual_model": {"const": "gpt-5.3-codex-spark"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["completed", "needs-replan"]},
          "requested_model": {"const": "gpt-5.6-luna"}
        },
        "required": ["status", "requested_model"]
      },
      "then": {
        "properties": {
          "actual_model": {"const": "gpt-5.6-luna"}
        }
      }
    }
  ]
}
