{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Worker Return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "return_type",
    "version",
    "packet_id",
    "bead_id",
    "session_id",
    "segment_id",
    "status",
    "requested_model",
    "actual_model",
    "attestation_source",
    "attestation_status",
    "completed_evidence",
    "files_touched",
    "mutation_state",
    "commands_run",
    "validation",
    "decision_required",
    "bounded_options",
    "recommendation",
    "remaining_scope",
    "usage",
    "residual_risks"
  ],
  "properties": {
    "return_type": {
      "type": "string",
      "const": "cwo-native-worker-return"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "bead_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "needs-architect-realignment",
        "budget-exhausted",
        "model-mismatch"
      ]
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "actual_model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attestation_source": {
      "type": "string",
      "minLength": 1
    },
    "attestation_status": {
      "type": "string",
      "enum": [
        "trusted",
        "missing",
        "mismatch",
        "untrusted",
        "denied"
      ]
    },
    "completed_evidence": {
      "type": "string",
      "minLength": 1
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mutation_state": {
      "type": "string",
      "enum": [
        "clean",
        "modified",
        "committed",
        "unknown"
      ]
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    },
    "decision_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bounded_options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "type": "string"
    },
    "remaining_scope": {
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls",
        "elapsed_seconds",
        "context_compactions",
        "full_suite_runs"
      ],
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "context_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "full_suite_runs": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "requested_model": {
            "const": "gpt-5.3-codex-spark"
          },
          "actual_model": {
            "const": "gpt-5.3-codex-spark"
          },
          "attestation_status": {
            "const": "trusted"
          },
          "attestation_source": {
            "const": "trusted-control-plane-session-metadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs-architect-realignment",
              "budget-exhausted",
              "model-mismatch"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decision_required": {
            "type": "array",
            "minItems": 1
          },
          "bounded_options": {
            "type": "array",
            "minItems": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "remaining_scope": {
            "type": "object",
            "minProperties": 1
          }
        },
        "required": [
          "decision_required",
          "bounded_options",
          "recommendation",
          "remaining_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "model-mismatch"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "actual_model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
