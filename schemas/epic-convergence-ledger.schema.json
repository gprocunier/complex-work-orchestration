{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Epic Convergence Ledger Record",
  "type": "object",
  "required": [
    "record_type",
    "version",
    "epic_id",
    "work_unit_id",
    "bead_id",
    "packet_id",
    "session_id",
    "model",
    "phase",
    "event",
    "call_category",
    "usage",
    "artifact_disposition",
    "graph_counters",
    "timestamp",
    "previous_record_sha256",
    "record_sha256"
  ],
  "properties": {
    "record_type": {"const": "cwo-epic-convergence-ledger-record"},
    "version": {"const": 1},
    "epic_id": {"type": ["string", "null"]},
    "work_unit_id": {"type": ["string", "null"]},
    "bead_id": {"type": ["string", "null"]},
    "packet_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "phase": {"type": ["string", "null"]},
    "event": {"type": ["string", "null"]},
    "call_category": {
      "enum": [
        "productive",
        "validation",
        "attestation",
        "fit",
        "monitoring",
        "recovery",
        "pm",
        "architect",
        "unknown",
        null
      ]
    },
    "usage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "tool_calls",
            "runtime_seconds",
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "context_compactions",
            "full_suite_runs"
          ],
          "properties": {
            "tool_calls": {"type": ["integer", "null"], "minimum": 0},
            "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "total_tokens": {"type": ["integer", "null"], "minimum": 0},
            "context_compactions": {"type": ["integer", "null"], "minimum": 0},
            "full_suite_runs": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact_disposition": {"type": ["string", "null"]},
    "graph_counters": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "beads_total",
            "beads_open",
            "beads_closed",
            "graph_depth",
            "work_units_total",
            "work_units_open",
            "work_units_closed",
            "routine_repair_children",
            "worker_sessions"
          ],
          "properties": {
            "beads_total": {"type": ["integer", "null"], "minimum": 0},
            "beads_open": {"type": ["integer", "null"], "minimum": 0},
            "beads_closed": {"type": ["integer", "null"], "minimum": 0},
            "graph_depth": {"type": ["integer", "null"], "minimum": 0},
            "work_units_total": {"type": ["integer", "null"], "minimum": 0},
            "work_units_open": {"type": ["integer", "null"], "minimum": 0},
            "work_units_closed": {"type": ["integer", "null"], "minimum": 0},
            "routine_repair_children": {"type": ["integer", "null"], "minimum": 0},
            "worker_sessions": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "previous_record_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
