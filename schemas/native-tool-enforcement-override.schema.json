{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/native-tool-enforcement-override.schema.json",
  "title": "Native Tool Enforcement Override v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "override_type",
    "version",
    "schema",
    "authorization_id",
    "authorization_canonical_sha256",
    "outer_authority_id",
    "outer_authority_file_sha256",
    "outer_authority_canonical_sha256",
    "campaign_nonce",
    "candidate_commit",
    "candidate_tree",
    "max_workers",
    "max_mutating_workers",
    "single_use",
    "risk_acknowledgement",
    "canonical_override_sha256"
  ],
  "properties": {
    "override_type": {
      "const": "cwo-native-tool-enforcement-override"
    },
    "version": {
      "const": 1
    },
    "schema": {
      "const": "schemas/native-tool-enforcement-override.schema.json"
    },
    "authorization_id": {
      "$ref": "#/$defs/uuid"
    },
    "authorization_canonical_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "outer_authority_id": {
      "$ref": "#/$defs/uuid"
    },
    "outer_authority_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "outer_authority_canonical_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "campaign_nonce": {
      "$ref": "#/$defs/uuid"
    },
    "candidate_commit": {
      "$ref": "#/$defs/git_object"
    },
    "candidate_tree": {
      "$ref": "#/$defs/git_object"
    },
    "max_workers": {
      "const": 2
    },
    "max_mutating_workers": {
      "const": 1
    },
    "single_use": {
      "const": true
    },
    "risk_acknowledgement": {
      "const": "unlisted-built-ins-may-act-before-detection"
    },
    "canonical_override_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_object": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
