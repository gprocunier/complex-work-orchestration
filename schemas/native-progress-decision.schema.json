{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/native-progress-decision.schema.json",
  "title": "native-progress-decision",
  "$comment": "Historical v1 inspection only. Schema conformance never authorizes dispatch or productive continuation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_type": {"const": "cwo-native-progress-decision"},
    "version": {"const": 1},
    "outcome": {"enum": ["continue", "early-warning", "pm-realignment", "protected-stop", "completed"]},
    "pm_action": {"enum": ["none", "packet-refinement", "architect-question", "material-split", "protected-stop"]},
    "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason_records": {"type": "array", "items": {"$ref": "#/$defs/reason_record"}},
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "planned": {"type": "object"},
    "actual": {"type": "object"},
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_calls_vs_p90": {"type": "integer"},
        "runtime_seconds_vs_p90": {"type": "number"},
        "planned_read_to_mutation_ratio": {"type": "number", "minimum": 0},
        "actual_read_to_mutation_ratio": {"type": "number", "minimum": 0},
        "retained_productive_artifacts": {"type": "integer", "minimum": 0},
        "pure_waste": {"type": "boolean"}
      },
      "required": ["tool_calls_vs_p90", "runtime_seconds_vs_p90", "planned_read_to_mutation_ratio", "actual_read_to_mutation_ratio", "retained_productive_artifacts", "pure_waste"]
    },
    "realignment": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completed_evidence": {"type": "array", "items": {"type": "string"}},
            "mutation_state": {"enum": ["clean", "modified"]},
            "discovered_work": {"type": "array", "items": {"type": "string"}},
            "revised_scores": {"type": "object"},
            "revised_estimate": {"type": "object"},
            "decision_required": {"enum": ["packet-refinement", "architect-question", "material-split"]},
            "bounded_options": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "recommendation": {"type": "string", "minLength": 1},
            "retained_artifacts": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["completed_evidence", "mutation_state", "discovered_work", "revised_scores", "revised_estimate", "decision_required", "bounded_options", "recommendation", "retained_artifacts"]
        }
      ]
    },
    "stop_scope": {"$ref": "#/$defs/stop_scope"},
    "authorized_continuation_paths": {
      "type": "array", "uniqueItems": true, "maxItems": 0,
      "items": {"$ref": "#/$defs/continuation_path"}
    },
    "scope_authority": {"$ref": "#/$defs/scope_authority"}
  },
  "required": ["decision_type", "version", "outcome", "pm_action", "reasons", "reason_records", "warnings", "planned", "actual", "calibration", "realignment", "stop_scope", "authorized_continuation_paths", "scope_authority"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stop_scope": {"enum": ["child", "cohort", "execution-path", "complete-task", "publication"]},
    "continuation_path": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "target_id", "conditions"],
      "properties": {
        "path": {"enum": ["retry-child", "replace-child", "continue-cohort", "retry-cohort", "alternate-execution-path", "resume-task", "task-remediation", "publication-review", "operator-adjudication"]},
        "target_id": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source_type", "source_id", "source_sha256", "actor_id", "actor_role", "identity_source", "authorized_scope", "parent_receipt_sha256", "verification", "authority_sha256"],
      "properties": {
        "version": {"const": 1},
        "source_type": {"enum": ["worker-discovery", "pm-observation", "architect-judgment", "operator-directive", "policy-enforcement"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["operative-worker", "critic", "project-manager", "architect", "supervisor-policy", "operator"]},
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {"$ref": "#/$defs/stop_scope"},
        "parent_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_record": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "authority_provenance", "detected_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "authority_provenance": {"$ref": "#/$defs/scope_authority"},
        "detected_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
