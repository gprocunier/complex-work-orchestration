{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complex Work Orchestration Route Result",
  "type": "object",
  "required": [
    "route",
    "task_class",
    "risk_level",
    "data_sensitivity",
    "data_sensitivity_source",
    "data_sensitivity_heuristic",
    "data_sensitivity_provenance",
    "data_sensitivity_disclaimer",
    "dispatch_sensitivity",
    "share_boundary",
    "operative_route",
    "critic_route",
    "peer_review_route",
    "ranked_experts",
    "ranked_executors",
    "recommended_executor",
    "beads_context_depth",
    "beads_context_depth_provenance",
    "zero_trust_consensus_required",
    "zero_trust_consensus_trigger_reasons",
    "zero_trust_minimum_independent_domains",
    "zero_trust_policy_version",
    "model_synthesis"
  ],
  "properties": {
    "route": {"type": "string"},
    "task_class": {"type": "string"},
    "risk_level": {"type": "string"},
    "risk_assessment": {
      "type": "object",
      "description": "Risk features found in the task text, independent of expert matches, and the floor they set. Absent from routes recorded before routing risk features existed.",
      "required": ["version", "features", "floor", "floor_reasons", "required_experts", "expert_risk", "risk_level"],
      "properties": {
        "version": {"type": "integer"},
        "features": {"type": "array", "items": {"type": "object", "required": ["feature", "terms", "resolved"], "properties": {"feature": {"type": "string"}, "terms": {"type": "array", "items": {"type": "string"}}, "resolved": {"type": ["string", "null"], "description": "Always null in this version: risk narrowing is not supported. A string appears only in older records."}}}},
        "floor": {"type": ["string", "null"]},
        "floor_reasons": {"type": "array", "items": {"type": "string"}},
        "required_experts": {"type": "array", "items": {"type": "string"}},
        "expert_risk": {"type": "string"},
        "risk_level": {"type": "string"},
        "assessed_segments": {"type": "integer", "minimum": 1, "description": "The joined text plus each original or appended segment the caller passed."},
        "assessed_prefixes": {"type": "integer", "minimum": 0, "description": "How many cumulative prefixes of the segments (segments 0..i, concatenated directly) were also assessed; 0 when no segments were passed."},
        "unmet_required_experts": {"type": "array", "items": {"type": "object", "required": ["expert", "reason"], "properties": {"expert": {"type": "string"}, "reason": {"type": "string"}}}, "description": "Each expert a risk feature requires that routing could not add, with the reason. Empty when every required expert is in ranked_experts; absent from older records."},
        "scope_resolution": {
          "type": "object",
          "description": "Kept for compatibility with records written before narrowing was removed. This version never writes it: risk narrowing is not supported and every narrowing input is refused.",
          "required": ["action", "paths", "environment", "evidence", "applied", "resolved", "reasons", "floor_before"],
          "properties": {
            "action": {"type": ["string", "null"]},
            "paths": {"type": "array", "items": {"type": "string"}},
            "environment": {"type": ["string", "null"]},
            "evidence": {"type": ["string", "null"], "description": "The evidence file path the scope named, or the bare reference it supplied instead (which never resolves)."},
            "evidence_sha256": {"type": ["string", "null"], "description": "The sha256 the scope declared for the evidence file."},
            "evidence_root": {"enum": ["repository", "evidence-dir", null], "description": "What the evidence path is relative to."},
            "evidence_status": {"type": "string", "description": "verified, or why the evidence was not accepted (absent, not-a-recorded-file, unsafe-path, unsafe-root, symlink, missing, not-a-regular-file, too-large, unreadable, digest-mismatch, malformed, mismatch)."},
            "evidence_lists": {"type": "array", "items": {"type": "string"}, "description": "The features a verified evidence file lists as resolved."},
            "applied": {"type": "boolean"},
            "resolved": {"type": "array", "items": {"type": "object", "required": ["feature", "evidence"], "properties": {"feature": {"type": "string"}, "evidence": {"type": "string"}, "sha256": {"type": "string"}}}},
            "retained": {"type": "array", "items": {"type": "object", "required": ["feature", "reason"], "properties": {"feature": {"type": "string"}, "reason": {"type": "string"}}}, "description": "Each feature the scope did not resolve, with the reason."},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "floor_before": {"type": ["string", "null"]}
          }
        }
      }
    },
    "data_sensitivity": {"enum": ["public", "redacted", "internal", "restricted"]},
    "data_sensitivity_source": {"enum": ["heuristic", "operator-declared"]},
    "data_sensitivity_heuristic": {"enum": ["public", "redacted", "internal", "restricted"]},
    "data_sensitivity_disclaimer": {"type": "string"},
    "data_sensitivity_provenance": {
      "type": "object",
      "required": [
        "source",
        "declared_sensitivity",
        "heuristic_sensitivity",
        "effective_sensitivity",
        "advisory_heuristic",
        "disclaimer",
        "reason"
      ],
      "properties": {
        "source": {"enum": ["heuristic", "operator-declared"]},
        "declared_sensitivity": {
          "anyOf": [
            {"enum": ["public", "redacted", "internal", "restricted"]},
            {"type": "null"}
          ]
        },
        "heuristic_sensitivity": {"enum": ["public", "redacted", "internal", "restricted"]},
        "effective_sensitivity": {"enum": ["public", "redacted", "internal", "restricted"]},
        "advisory_heuristic": {"type": "boolean"},
        "disclaimer": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "dispatch_sensitivity": {"type": "string"},
    "share_boundary": {"type": "string"},
    "operative_route": {"type": "object"},
    "critic_route": {"type": "object"},
    "peer_review_route": {"type": "object"},
    "execution_environment": {"type": "string"},
    "execution_environment_profile": {"type": "object"},
    "project_manager_executor": {"type": ["string", "null"]},
    "primary_architect_executor": {"type": ["string", "null"]},
    "architecture_counter_review_executor": {"type": ["string", "null"]},
    "architecture_authority": {"type": "string"},
    "access_profile": {"type": ["string", "null"]},
    "local_worker_opt_in_source": {"type": ["string", "null"]},
    "beads_context_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
    "beads_context_depth_source": {"enum": ["autosized", "explicit"]},
    "beads_context_depth_rationale": {"type": "array", "items": {"type": "string"}},
    "beads_context_depth_provenance": {
      "type": "object",
      "required": ["source", "requested_depth", "computed_depth", "effective_depth", "override_field", "reason", "actor_context"],
      "properties": {
        "source": {"enum": ["autosized", "explicit"]},
        "requested_depth": {
          "anyOf": [
            {"enum": ["none", "summary", "focused", "heavy", "audit"]},
            {"type": "null"}
          ]
        },
        "computed_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
        "effective_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
        "override_field": {
          "anyOf": [
            {"enum": ["beads_context_depth"]},
            {"type": "null"}
          ]
        },
        "reason": {"type": "string"},
        "actor_context": {"type": "string"}
      }
    },
    "external_contract_allowed": {"type": "boolean"},
    "local_worker_allowed": {"type": "boolean"},
    "prefer_local_worker": {"type": "boolean"},
    "has_external_expert_contracts": {"type": "boolean"},
    "has_local_worker_contracts": {"type": "boolean"},
    "external_experts": {"type": "array", "items": {"type": "string"}},
    "local_worker_experts": {"type": "array", "items": {"type": "string"}},
    "internal_experts": {"type": "array", "items": {"type": "string"}},
    "acceptance_required_experts": {"type": "array", "items": {"type": "string"}},
    "evaluator_required": {"type": "boolean"},
    "architect_adjudication_required": {"type": "boolean"},
    "ranked_experts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommended_executor": {"type": "string"},
          "selected_executor": {"type": "object"},
          "executor_policy_violations": {"type": "array", "items": {"type": "string"}},
          "executor_candidates": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "ranked_executors": {"type": "array", "items": {"type": "object"}},
    "recommended_executor": {"type": "string"},
    "selected_executor": {"type": "object"},
    "provider_conflict_detected": {"type": "boolean"},
    "provider_conflict_domains": {"type": "array", "items": {"type": "string"}},
    "provider_diversity_required": {"type": "boolean"},
    "peer_review_required": {"type": "boolean"},
    "peer_review_count": {"type": "integer", "minimum": 0},
    "peer_review_labels": {"type": "array", "items": {"type": "string"}},
    "blocking_review_required": {"type": "boolean"},
    "blocking_review_active": {"type": "boolean"},
    "blocking_review_gate": {"type": ["string", "null"]},
    "blocking_review_executor": {"type": ["string", "null"]},
    "blocking_review_job_description_label": {"type": ["string", "null"]},
    "blocking_review_waiver_required": {"type": "boolean"},
    "blocking_review_failure_behavior": {"type": ["string", "null"]},
    "blocking_review_required_evidence": {"type": "array", "items": {"type": "string"}},
    "quarantine_on_fail": {"type": "boolean"},
    "local_secure_review_executor": {"type": ["string", "null"]},
    "zero_trust_consensus_required": {"type": "boolean"},
    "zero_trust_consensus_trigger_reasons": {"type": "array", "items": {"type": "string"}},
    "zero_trust_minimum_independent_domains": {"type": "integer", "minimum": 1},
    "zero_trust_policy_version": {"type": ["integer", "string", "null"]},
    "model_synthesis": {
      "type": "object",
      "required": [
        "recommended_mode",
        "activation_state",
        "active",
        "active_modes",
        "requires_user_acceptance",
        "prompt_user_in_plan_mode",
        "synthesis_pattern",
        "synthesis_owner",
        "trigger_reasons",
        "recommended_panel",
        "mentioned_provider_camps",
        "required_share_boundary",
        "external_reviewers_require_opt_in",
        "artifact_contract",
        "input_disposition_policy",
        "partial_synthesis_policy",
        "provider_conflict_policy",
        "provider_conflict_flags",
        "rationale"
      ],
      "properties": {
        "recommended_mode": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "activation_state": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "active": {"type": "boolean"},
        "active_modes": {"type": "array", "items": {"type": "string"}},
        "requires_user_acceptance": {"type": "boolean"},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "synthesis_pattern": {"type": "string"},
        "synthesis_owner": {"type": "string"},
        "trigger_reasons": {"type": "array", "items": {"type": "string"}},
        "recommended_panel": {"type": "array", "items": {"type": "object"}},
        "mentioned_provider_camps": {"type": "array", "items": {"type": "string"}},
        "required_share_boundary": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "external_reviewers_require_opt_in": {"type": "boolean"},
        "artifact_contract": {"type": "array", "items": {"type": "string"}},
        "input_disposition_policy": {"type": "object"},
        "partial_synthesis_policy": {"type": "object"},
        "provider_conflict_policy": {"type": "object"},
        "provider_conflict_flags": {"type": "array", "items": {"type": "object"}},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "guard_labels": {"type": "array", "items": {"type": "string"}},
    "hard_stops": {"type": "array", "items": {"type": "string"}}
  }
}
