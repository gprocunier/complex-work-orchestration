{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/generation11-terminal-facts.schema.json",
  "title": "Generation 11 Terminal Facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "version", "schema", "recorded_at", "identity",
    "source_bindings", "facts", "source_root_sha256",
    "canonical_terminal_facts_sha256"
  ],
  "properties": {
    "artifact_type": {"const": "cwo-generation11-terminal-facts"},
    "version": {"const": 1},
    "schema": {"const": "schemas/generation11-terminal-facts.schema.json"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "identity": {"$ref": "#/$defs/identity"},
    "source_bindings": {"$ref": "#/$defs/source_bindings"},
    "facts": {"$ref": "#/$defs/facts"},
    "source_root_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_terminal_facts_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id", "manifest_id", "campaign_nonce", "control_turn_id",
        "bead_id", "work_unit_id", "live_generation", "session_id", "turn_id",
        "candidate_commit", "candidate_tree"
      ],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/uuid"},
        "manifest_id": {"$ref": "#/$defs/uuid"},
        "campaign_nonce": {"$ref": "#/$defs/uuid"},
        "control_turn_id": {"type": "string", "minLength": 1},
        "bead_id": {"type": "string", "minLength": 1},
        "work_unit_id": {"type": "string", "minLength": 1},
        "live_generation": {"const": 11},
        "session_id": {"$ref": "#/$defs/uuid"},
        "turn_id": {"$ref": "#/$defs/uuid"},
        "candidate_commit": {"$ref": "#/$defs/git_object"},
        "candidate_tree": {"$ref": "#/$defs/git_object"}
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_file_sha256", "manifest_file_sha256",
        "authorization_state_file_sha256", "failure_evidence_file_sha256",
        "containment_file_sha256", "global_claim_file_sha256",
        "authorization_marker_file_sha256", "nonce_marker_file_sha256",
        "scope_state_file_sha256", "preflight_file_sha256",
        "pre_mutation_receipt_file_sha256", "pre_mutation_adjudication_file_sha256",
        "pre_live_receipt_file_sha256", "pre_live_adjudication_file_sha256",
        "allocation_ledger_file_sha256", "allocation_audit_file_sha256",
        "steering_registry_file_sha256", "terminal_session_file_sha256",
        "outer_authority_file_sha256", "recovery_cause_analysis_sha256",
        "recovery_steering_receipt_file_sha256",
        "recovery_steering_session_file_sha256",
        "generation11_runner_source_sha256",
        "generation11_session_boundary_source_sha256"
      ],
      "properties": {
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_state_file_sha256": {"$ref": "#/$defs/sha256"},
        "failure_evidence_file_sha256": {"$ref": "#/$defs/sha256"},
        "containment_file_sha256": {"$ref": "#/$defs/sha256"},
        "global_claim_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_marker_file_sha256": {"$ref": "#/$defs/sha256"},
        "nonce_marker_file_sha256": {"$ref": "#/$defs/sha256"},
        "scope_state_file_sha256": {"$ref": "#/$defs/sha256"},
        "preflight_file_sha256": {"$ref": "#/$defs/sha256"},
        "pre_mutation_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "pre_mutation_adjudication_file_sha256": {"$ref": "#/$defs/sha256"},
        "pre_live_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "pre_live_adjudication_file_sha256": {"$ref": "#/$defs/sha256"},
        "allocation_ledger_file_sha256": {"$ref": "#/$defs/sha256"},
        "allocation_audit_file_sha256": {"$ref": "#/$defs/sha256"},
        "steering_registry_file_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_session_file_sha256": {"$ref": "#/$defs/sha256"},
        "outer_authority_file_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_cause_analysis_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_steering_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_steering_session_file_sha256": {"$ref": "#/$defs/sha256"},
        "generation11_runner_source_sha256": {"$ref": "#/$defs/sha256"},
        "generation11_session_boundary_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "source_labels", "value", "fact_sha256"],
      "properties": {
        "provenance": {
          "enum": ["direct-session-telemetry", "source-code-derived-inference"]
        },
        "source_labels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "value": {"type": "object"},
        "fact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_empty_boundary", "recovery_entry",
        "interrupted_terminal_event", "no_replacement_read"
      ],
      "properties": {
        "initial_empty_boundary": {"$ref": "#/$defs/fact"},
        "recovery_entry": {"$ref": "#/$defs/fact"},
        "interrupted_terminal_event": {"$ref": "#/$defs/fact"},
        "no_replacement_read": {"$ref": "#/$defs/fact"}
      }
    }
  }
}
