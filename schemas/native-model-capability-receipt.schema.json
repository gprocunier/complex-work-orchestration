{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/native-model-capability-receipt.schema.json",
  "title": "CWO Native Model Capability Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "version",
    "requested_model",
    "configured_model",
    "advertised",
    "advertised_models",
    "spawn_accepted",
    "canary_session_id",
    "attestation_source",
    "attested_model",
    "tool_calls",
    "context_compactions",
    "runtime_seconds",
    "closure_receipt",
    "tool_surface_id",
    "decision",
    "session_evidence_sha256",
    "authority_provenance",
    "issued_at",
    "expires_at",
    "receipt_sha256"
  ],
  "properties": {
    "receipt_type": {
      "const": "cwo-native-model-capability-receipt"
    },
    "version": {
      "const": 2
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "configured_model": {
      "type": "string",
      "minLength": 1
    },
    "advertised": {
      "type": "boolean"
    },
    "advertised_models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "spawn_accepted": {
      "const": true
    },
    "canary_session_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_source": {
      "const": "trusted-session-jsonl"
    },
    "attested_model": {
      "type": "string",
      "minLength": 1
    },
    "tool_calls": {
      "const": 0
    },
    "context_compactions": {
      "const": 0
    },
    "runtime_seconds": {
      "type": "number",
      "minimum": 0
    },
    "closure_receipt": {
      "const": true
    },
    "tool_surface_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "native-capability-confirmed"
    },
    "session_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authority_provenance": {
      "$ref": "#/$defs/authority_provenance"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "source_type", "source_id", "source_sha256", "actor_id",
        "actor_role", "identity_source", "authorized_scope",
        "parent_receipt_sha256", "verification", "authority_sha256"
      ],
      "properties": {
        "version": {"const": 1},
        "source_type": {
          "enum": [
            "worker-discovery", "pm-observation", "architect-judgment",
            "operator-directive", "policy-enforcement"
          ]
        },
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {
          "enum": [
            "operative-worker", "critic", "project-manager", "architect",
            "supervisor-policy", "operator"
          ]
        },
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {
          "enum": ["child", "cohort", "execution-path", "complete-task", "publication"]
        },
        "parent_receipt_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
