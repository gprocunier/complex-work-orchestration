{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full Auto Run Authorization v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_type", "version", "schema", "authorization_id", "run_generation",
    "live_generation", "predecessor_live_generation", "issued_at", "issued_by",
    "operator_authority", "initial_state", "scope", "bindings", "supersession",
    "executors", "budgets", "mandatory_gates", "persistence", "forbidden",
    "live_relaunch_rule", "release", "canonical_authorization_sha256"
  ],
  "properties": {
    "authorization_type": {"const": "cwo-full-auto-run-authorization"},
    "version": {"const": 4},
    "schema": {"const": "schemas/full-auto-run-authorization.schema.json"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "run_generation": {"type": "integer", "minimum": 1},
    "live_generation": {"type": "integer", "minimum": 1},
    "predecessor_live_generation": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "format": "date-time"},
    "issued_by": {"type": "string", "minLength": 1},
    "operator_authority": {"type": "string", "minLength": 1},
    "initial_state": {"const": "active"},
    "scope": {"$ref": "#/$defs/scope"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "supersession": {"$ref": "#/$defs/supersession"},
    "executors": {"$ref": "#/$defs/executors"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "mandatory_gates": {"$ref": "#/$defs/mandatory_gates"},
    "persistence": {"$ref": "#/$defs/persistence"},
    "forbidden": {"$ref": "#/$defs/forbidden"},
    "live_relaunch_rule": {"$ref": "#/$defs/live_relaunch"},
    "release": {"$ref": "#/$defs/release"},
    "canonical_authorization_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "nonempty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["epic_id", "parent_work_unit_id", "ordered_work_units"],
      "properties": {
        "epic_id": {"type": "string", "minLength": 1},
        "parent_work_unit_id": {"type": "string", "minLength": 1},
        "ordered_work_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": [
        "checkpoint_commit", "checkpoint_tree", "origin_main_commit",
        "guarded_primary_diff_sha256", "pickup_path", "pickup_sha256",
        "recovery_plan_path", "recovery_plan_sha256", "campaign_nonce",
        "predecessor_authorization_id", "predecessor_failure_evidence_file_sha256",
        "predecessor_failure_evidence_canonical_sha256", "predecessor_containment_file_sha256",
        "predecessor_containment_canonical_sha256", "backup_ref"
      ],
      "properties": {
        "checkpoint_commit": {"$ref": "#/$defs/git_object"},
        "checkpoint_tree": {"$ref": "#/$defs/git_object"},
        "origin_main_commit": {"$ref": "#/$defs/git_object"},
        "guarded_primary_diff_sha256": {"$ref": "#/$defs/sha256"},
        "pickup_path": {"type": "string", "minLength": 1},
        "pickup_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_plan_path": {"type": "string", "minLength": 1},
        "recovery_plan_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_nonce": {"$ref": "#/$defs/uuid"},
        "predecessor_authorization_id": {"$ref": "#/$defs/uuid"},
        "predecessor_failure_evidence_file_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_failure_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_containment_file_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_containment_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "backup_ref": {"type": "string", "pattern": "^refs/heads/", "minLength": 12}
      }
    },
    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": [
        "prior_authorization_id", "prior_terminal_state", "prior_live_generation",
        "prior_allocations", "prior_ambiguities", "prior_allowed_actions",
        "reuse_resume_retry_substitution_salvage_bridge"
      ],
      "properties": {
        "prior_authorization_id": {"$ref": "#/$defs/uuid"},
        "prior_terminal_state": {"const": "containment-only"},
        "prior_live_generation": {"type": "integer", "minimum": 0},
        "prior_allocations": {"type": "integer", "minimum": 0},
        "prior_ambiguities": {"const": 0},
        "prior_allowed_actions": {"const": 0},
        "reuse_resume_retry_substitution_salvage_bridge": {"const": false}
      }
    },
    "executors": {
      "type": "object", "additionalProperties": false,
      "required": ["final_architect", "steering", "operative", "outside_critic"],
      "properties": {
        "final_architect": {"const": "current-codex-main-thread"},
        "steering": {
          "const": {"model": "gpt-5.6-sol", "effort": "max", "surface": "codex-app-server-stdio", "authority": "read-only-evidence"}
        },
        "operative": {
          "const": {"model": "gpt-5.3-codex-spark", "effort": "low", "surface": "codex-app-server-stdio", "session_policy": "fresh-nonresumable-nonsalvageable"}
        },
        "outside_critic": {
          "const": {"model": "claude-opus-4-6", "effort": "max", "surface": "claude-cli-as-greg", "authority": "evidence-only"}
        }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sol_consultations_observed_before_v10", "sol_consultations_added",
        "sol_consultations_global_hard", "opus_reviews_observed_before_v10",
        "opus_reviews_added", "opus_reviews_global_hard",
        "live_generations_consumed_before_current", "live_generations_global_hard",
        "live_generations_remaining_exact", "spark_live_turn_starts_per_generation_exact",
        "spark_read_only_validation_sessions_hard", "spark_compactions_hard",
        "full_repository_suites_observed_before_v10", "full_repository_suites_added",
        "full_repository_suites_global_hard", "focused_validation_bundles_hard",
        "implementation_correction_sprints_hard", "origin_reconciliation_cycles_hard",
        "primary_checkout_mutations_hard"
      ],
      "properties": {
        "sol_consultations_observed_before_v10": {"type": "integer", "minimum": 0},
        "sol_consultations_added": {"type": "integer", "minimum": 0},
        "sol_consultations_global_hard": {"type": "integer", "minimum": 0},
        "opus_reviews_observed_before_v10": {"type": "integer", "minimum": 0},
        "opus_reviews_added": {"type": "integer", "minimum": 0},
        "opus_reviews_global_hard": {"type": "integer", "minimum": 0},
        "live_generations_consumed_before_current": {"type": "integer", "minimum": 0},
        "live_generations_global_hard": {"type": "integer", "minimum": 1},
        "live_generations_remaining_exact": {"const": 1},
        "spark_live_turn_starts_per_generation_exact": {"const": 7},
        "spark_read_only_validation_sessions_hard": {"type": "integer", "minimum": 0},
        "spark_compactions_hard": {"const": 0},
        "full_repository_suites_observed_before_v10": {"type": "integer", "minimum": 0},
        "full_repository_suites_added": {"type": "integer", "minimum": 0},
        "full_repository_suites_global_hard": {"type": "integer", "minimum": 0},
        "focused_validation_bundles_hard": {"type": "integer", "minimum": 0},
        "implementation_correction_sprints_hard": {"type": "integer", "minimum": 0},
        "origin_reconciliation_cycles_hard": {"type": "integer", "minimum": 0},
        "primary_checkout_mutations_hard": {"const": 0}
      }
    },
    "mandatory_gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "strict_authorization_v4", "contained_prior_generation_proof",
        "fresh_exact_sol_pre_mutation_receipt", "successor_contract_validation",
        "frozen_release_patch", "fresh_opus_candidate_review",
        "fresh_exact_sol_pre_live_receipt", "campaign_manifest_v1",
        "single_shot_per_generation_live_campaign", "main_thread_adjudication_each_gate",
        "guarded_primary_diff_stability", "staging_ci_before_main", "published_install_parity"
      ],
      "properties": {
        "strict_authorization_v4": {"const": true},
        "contained_prior_generation_proof": {"const": true},
        "fresh_exact_sol_pre_mutation_receipt": {"const": true},
        "successor_contract_validation": {"const": true},
        "frozen_release_patch": {"const": true},
        "fresh_opus_candidate_review": {"const": true},
        "fresh_exact_sol_pre_live_receipt": {"const": true},
        "campaign_manifest_v1": {"const": true},
        "single_shot_per_generation_live_campaign": {"const": true},
        "main_thread_adjudication_each_gate": {"const": true},
        "guarded_primary_diff_stability": {"const": true},
        "staging_ci_before_main": {"const": true},
        "published_install_parity": {"const": true}
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_level_full_auto_survives_recoverable_failure",
        "operator_recheck_required_for_routine_recovery",
        "evidence_bearing_live_failure_becomes_terminal",
        "fresh_successor_requires_new_authorization_id_nonce_receipts_sessions_and_paths",
        "combined_confidence_formula", "combined_confidence_minimum", "operator_stop_conditions"
      ],
      "properties": {
        "run_level_full_auto_survives_recoverable_failure": {"const": true},
        "operator_recheck_required_for_routine_recovery": {"const": false},
        "evidence_bearing_live_failure_becomes_terminal": {"const": true},
        "fresh_successor_requires_new_authorization_id_nonce_receipts_sessions_and_paths": {"const": true},
        "combined_confidence_formula": {"const": "min(main,sol) when sol-used else main"},
        "combined_confidence_minimum": {"const": 0.5},
        "operator_stop_conditions": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "forbidden": {
      "type": "object", "additionalProperties": false,
      "required": [
        "glm_5_2", "model_synthesis", "primary_checkout_mutation",
        "prior_authorization_reuse", "prior_nonce_session_receipt_registry_state_output_ledger_or_path_reuse",
        "worker_resume", "worker_salvage", "model_substitution", "evidence_bearing_live_retry",
        "generation_6", "sol_target_checkout_mutation", "release_before_live_acceptance",
        "force_push", "git_tag", "github_release"
      ],
      "properties": {
        "glm_5_2": {"const": true},
        "model_synthesis": {"const": true},
        "primary_checkout_mutation": {"const": true},
        "prior_authorization_reuse": {"const": true},
        "prior_nonce_session_receipt_registry_state_output_ledger_or_path_reuse": {"const": true},
        "worker_resume": {"const": true},
        "worker_salvage": {"const": true},
        "model_substitution": {"const": true},
        "evidence_bearing_live_retry": {"const": true},
        "generation_6": {"const": true},
        "sol_target_checkout_mutation": {"const": true},
        "release_before_live_acceptance": {"const": true},
        "force_push": {"const": true},
        "git_tag": {"const": true},
        "github_release": {"const": true}
      }
    },
    "live_relaunch": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pre_rpc_zero_artifact_relaunch_max", "requires_no_thread_start_request",
        "requires_no_allocation_intent", "requires_no_session_identity",
        "requires_no_audit_event", "requires_no_campaign_artifact"
      ],
      "properties": {
        "pre_rpc_zero_artifact_relaunch_max": {"const": 1},
        "requires_no_thread_start_request": {"const": true},
        "requires_no_allocation_intent": {"const": true},
        "requires_no_session_identity": {"const": true},
        "requires_no_audit_event": {"const": true},
        "requires_no_campaign_artifact": {"const": true}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authorized_only_after_accepting_live_evidence_and_main_go", "frozen_delta_required",
        "version_remains", "tag_or_github_release", "actions_after_gate"
      ],
      "properties": {
        "authorized_only_after_accepting_live_evidence_and_main_go": {"const": true},
        "frozen_delta_required": {"const": true},
        "version_remains": {"const": "0.2.0-dev"},
        "tag_or_github_release": {"const": false},
        "actions_after_gate": {"$ref": "#/$defs/nonempty_strings"}
      }
    }
  }
}
