{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Worker Packet",
  "type": "object",
  "additionalProperties": false,
    "required": [
      "packet_type",
      "version",
      "packet_id",
      "bead_id",
      "lane",
      "requested_model",
      "session_policy",
      "scope",
      "acceptance_checks",
      "budget",
      "escalation_triggers",
      "return_contract"
    ],
  "properties": {
    "packet_type": {
      "type": "string",
      "const": "cwo-native-worker-packet"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "bead_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "implementation",
        "validation",
        "review",
        "publish-report-admin"
      ]
    },
    "requested_model": {
      "type": "string",
      "const": "gpt-5.3-codex-spark"
    },
    "session_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_session_required",
        "resume_forbidden",
        "attestation",
        "source"
      ],
      "properties": {
        "fresh_session_required": {
          "type": "boolean",
          "const": true
        },
        "resume_forbidden": {
          "type": "boolean",
          "const": true
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "tool_mode",
            "model_authority",
            "self_report_authority",
            "required_actual_model"
          ],
          "properties": {
            "required": {
              "type": "boolean",
              "const": true
            },
            "tool_mode": {
              "type": "string",
              "const": "no-tools"
            },
            "model_authority": {
              "type": "string",
              "const": "trusted-control-plane-session-metadata"
            },
            "self_report_authority": {
              "type": "string",
              "const": "forbidden"
            },
            "required_actual_model": {
              "type": "string",
              "const": "gpt-5.3-codex-spark"
            }
          }
        },
        "source": {
          "type": "string",
          "const": "policy/native-worker-execution.yaml"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir",
        "allowed_paths",
        "allowed_actions",
        "prohibited_actions"
      ],
      "properties": {
        "workdir": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls_soft",
        "tool_calls_hard",
        "runtime_seconds_soft",
        "runtime_seconds_hard",
        "max_compactions",
        "max_full_suite_runs"
      ],
      "properties": {
        "tool_calls_soft": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_hard": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_soft": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_hard": {
          "type": "integer",
          "minimum": 0
        },
        "max_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "max_full_suite_runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "escalation_triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ambiguity",
        "architecture_ambiguity",
        "security_ambiguity",
        "policy_ambiguity",
        "soft_limit",
        "hard_limit",
        "compaction"
      ],
      "properties": {
        "scope_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "architecture_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "security_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "policy_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "soft_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distinct_soft_limits_required"
          ],
          "properties": {
            "distinct_soft_limits_required": {
              "type": "integer",
              "const": 2
            }
          }
        },
        "hard_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any_hard_limit",
            "status"
          ],
          "properties": {
            "any_hard_limit": {
              "type": "string",
              "const": "realignment"
            },
            "status": {
              "type": "string",
              "const": "needs-architect-realignment"
            }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any_compaction",
            "status"
          ],
          "properties": {
            "any_compaction": {
              "type": "string",
              "const": "hard-stop/realignment"
            },
            "status": {
              "type": "string",
              "const": "needs-architect-realignment"
            }
          }
        }
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_statuses",
        "required_fields"
      ],
      "properties": {
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "realignment_required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
