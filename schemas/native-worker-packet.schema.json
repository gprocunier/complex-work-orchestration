{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Worker Packet",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "checkedCommandSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_type": {"const": "cwo-checked-command-spec"},
        "version": {"const": 1},
        "command_id": {"type": "string", "minLength": 1},
        "mode": {"const": "argv"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "inherit_environment": {"type": "boolean"},
        "stdin": {"type": ["string", "null"]},
        "source": {"type": "null"},
        "preflights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "enum": ["json", "json-policy", "regex"]},
              "value": {"type": "string"}
            },
            "required": ["kind", "value"]
          }
        },
        "mutation_intent": {"type": "string", "enum": ["none", "workspace-scoped"]},
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "required": [
        "spec_type", "version", "command_id", "mode", "argv", "cwd", "env",
        "inherit_environment", "stdin", "source", "preflights", "mutation_intent",
        "allowed_paths", "timeout_seconds"
      ]
    },
    "checkedCommandSequenceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_type": {"const": "cwo-checked-command-sequence-spec"},
        "version": {"const": 1},
        "sequence_id": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "work_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workdir": {"type": "string", "minLength": 1},
        "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkedCommandSpec"}}
      },
      "required": ["spec_type", "version", "sequence_id", "packet_id", "work_plan_sha256", "workdir", "commands"]
    }
  },
  "required": [
    "packet_type",
    "version",
    "packet_id",
    "bead_id",
    "lane",
    "requested_model",
    "session_policy",
    "scope",
    "acceptance_checks",
    "budget",
    "escalation_triggers",
    "return_contract",
    "command_contract"
  ],
  "properties": {
    "packet_type": {
      "type": "string",
      "const": "cwo-native-worker-packet"
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "bead_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "implementation",
        "validation",
        "review",
        "publish-report-admin"
      ]
    },
    "requested_model": {
      "type": "string",
      "enum": [
        "gpt-5.3-codex-spark",
        "gpt-5.6-luna"
      ]
    },
    "session_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_session_required",
        "resume_forbidden",
        "attestation",
        "source"
      ],
      "properties": {
        "fresh_session_required": {
          "type": "boolean",
          "const": true
        },
        "resume_forbidden": {
          "type": "boolean",
          "const": true
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "tool_mode",
            "model_authority",
            "self_report_authority",
            "required_actual_model"
          ],
          "properties": {
            "required": {
              "type": "boolean",
              "const": true
            },
            "tool_mode": {
              "type": "string",
              "const": "no-tools"
            },
            "model_authority": {
              "type": "string",
              "const": "trusted-control-plane-session-metadata"
            },
            "self_report_authority": {
              "type": "string",
              "const": "forbidden"
            },
            "required_actual_model": {
              "type": "string",
              "enum": [
                "gpt-5.3-codex-spark",
                "gpt-5.6-luna"
              ]
            }
          }
        },
        "source": {
          "type": "string",
          "const": "policy/native-worker-execution.yaml"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir",
        "allowed_paths",
        "allowed_actions",
        "prohibited_actions"
      ],
      "properties": {
        "workdir": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls_soft",
        "tool_calls_hard",
        "runtime_seconds_soft",
        "runtime_seconds_hard",
        "max_compactions",
        "max_full_suite_runs"
      ],
      "properties": {
        "tool_calls_soft": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_hard": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_soft": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_hard": {
          "type": "integer",
          "minimum": 0
        },
        "max_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "max_full_suite_runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budget_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "policy_source",
        "overrides_applied",
        "overridden_fields"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "policy_source": {
          "const": "policy/native-worker-execution.yaml"
        },
        "overrides_applied": {
          "type": "boolean"
        },
        "overridden_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "tool_calls_soft",
              "tool_calls_hard",
              "runtime_seconds_soft",
              "runtime_seconds_hard",
              "max_compactions",
              "max_full_suite_runs"
            ]
          }
        }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode",
        "poll_interval_ms",
        "poll_lag_tolerance_ms",
        "arm_to_dispatch_max_ms",
        "control_turn_required",
        "segment_start_grace_seconds",
        "control_adapter",
        "required_capabilities",
        "interrupt_thresholds"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "mode": {
          "const": "live-fail-closed"
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 100
        },
        "poll_lag_tolerance_ms": {
          "type": "integer",
          "minimum": 0
        },
        "arm_to_dispatch_max_ms": {
          "type": "integer",
          "minimum": 100
        },
        "control_turn_required": {
          "const": true
        },
        "segment_start_grace_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "control_adapter": {
          "const": "native-multi-agent-v1"
        },
        "required_capabilities": {
          "type": "array",
          "const": [
            "interrupt",
            "close",
            "wait"
          ]
        },
        "interrupt_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_calls",
            "runtime_seconds"
          ],
          "properties": {
            "tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "validation_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_packet_id",
        "parent_packet_id",
        "attempt"
      ],
      "properties": {
        "root_packet_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_packet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "work_plan": {
      "type": "object",
      "minProperties": 1
    },
    "worker_commitment": {
      "type": "object",
      "minProperties": 1
    },
    "stage": {
      "const": "precommit-validated"
    },
    "operative_dispatch_authorized": {
      "const": false
    },
    "release_requires": {
      "const": "complex-work-orchestration-fsh.3"
    },
    "precommit_receipt": {
      "type": "object",
      "minProperties": 1
    },
    "precommit_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checked_command_sequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "checked-sequence-v1"},
        "spec": {"$ref": "#/$defs/checkedCommandSequenceSpec"},
        "spec_path": {"type": "string", "minLength": 1},
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_path": {"type": "string", "minLength": 1},
        "output_path": {"type": "string", "minLength": 1},
        "runner_argv": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"type": "string"}
        }
      },
      "required": ["mode", "spec", "spec_path", "spec_sha256", "state_path", "output_path", "runner_argv"]
    },
    "escalation_triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ambiguity",
        "architecture_ambiguity",
        "security_ambiguity",
        "policy_ambiguity",
        "soft_limit",
        "hard_limit",
        "compaction"
      ],
      "properties": {
        "scope_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "architecture_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "security_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "policy_ambiguity": {
          "type": "string",
          "const": "needs-architect-realignment"
        },
        "soft_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distinct_soft_limits_required"
          ],
          "properties": {
            "distinct_soft_limits_required": {
              "type": "integer",
              "const": 2
            }
          }
        },
        "hard_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any_hard_limit",
            "status"
          ],
          "properties": {
            "any_hard_limit": {
              "type": "string",
              "const": "realignment"
            },
            "status": {
              "type": "string",
              "const": "needs-architect-realignment"
            }
          }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any_compaction",
            "status"
          ],
          "properties": {
            "any_compaction": {
              "type": "string",
              "const": "hard-stop/realignment"
            },
            "status": {
              "type": "string",
              "const": "needs-architect-realignment"
            }
          }
        }
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_statuses",
        "required_fields"
      ],
      "properties": {
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "realignment_required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "command_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "wrapper": {
          "const": "scripts/run_checked_command.py"
        },
        "spec_schema": {
          "const": "schemas/checked-command-spec.schema.json"
        },
        "result_schema": {
          "const": "schemas/checked-command-result.schema.json"
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "argv",
              "shell-source",
              "python-source"
            ]
          },
          "uniqueItems": true
        },
        "typed_source_required_for": {
          "type": "array",
          "items": {
            "enum": [
              "python -c",
              "bash -c",
              "sh -c"
            ]
          },
          "uniqueItems": true
        },
        "complex_command_action": {
          "const": "checked-wrapper-required"
        },
        "construction_failure": {
          "const": "pm-realignment-no-quarantine"
        },
        "quarantine_failures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "wrapper",
        "spec_schema",
        "result_schema",
        "modes",
        "typed_source_required_for",
        "complex_command_action",
        "construction_failure",
        "quarantine_failures"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "budget_provenance",
          "supervision",
          "validation_lineage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "requested_model": {
            "const": "gpt-5.3-codex-spark"
          }
        },
        "required": [
          "requested_model"
        ]
      },
      "then": {
        "properties": {
          "session_policy": {
            "properties": {
              "attestation": {
                "properties": {
                  "required_actual_model": {
                    "const": "gpt-5.3-codex-spark"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requested_model": {
            "const": "gpt-5.6-luna"
          }
        },
        "required": [
          "requested_model"
        ]
      },
      "then": {
        "properties": {
          "session_policy": {
            "properties": {
              "attestation": {
                "properties": {
                  "required_actual_model": {
                    "const": "gpt-5.6-luna"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
