{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/native-tool-activation-claim.schema.json",
  "title": "CWO native tool activation permanent claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_type",
    "version",
    "schema",
    "claim_id",
    "activation_id",
    "profile",
    "plan_sha256",
    "approval_sha256",
    "approval_id",
    "approval_nonce",
    "action_sha256",
    "override_sha256",
    "launch_id",
    "pool_id",
    "pool_epoch",
    "campaign_nonce",
    "candidate_commit",
    "candidate_tree",
    "requested_workers",
    "mutating_workers",
    "fixed_cohort_sha256",
    "child_bindings_sha256",
    "output_paths",
    "controller_identity",
    "claimed_at",
    "claim_sha256"
  ],
  "properties": {
    "claim_type": {"const": "cwo-native-tool-activation-claim"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-tool-activation-claim.schema.json"},
    "claim_id": {"type": "string", "format": "uuid"},
    "activation_id": {"type": "string", "format": "uuid"},
    "profile": {
      "enum": ["n1-read-only", "n2-read-only", "n1-mutable"]
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "approval_sha256": {"$ref": "#/$defs/sha256"},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_nonce": {"type": "string", "minLength": 1},
    "action_sha256": {"$ref": "#/$defs/sha256"},
    "override_sha256": {"$ref": "#/$defs/sha256"},
    "launch_id": {"type": "string", "format": "uuid"},
    "pool_id": {"type": "string", "format": "uuid"},
    "pool_epoch": {"type": "string", "format": "uuid"},
    "campaign_nonce": {"type": "string", "format": "uuid"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_workers": {"type": "integer", "minimum": 1, "maximum": 2},
    "mutating_workers": {"type": "integer", "minimum": 0, "maximum": 1},
    "fixed_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "child_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "output_paths": {"type": "object"},
    "controller_identity": {"type": "object"},
    "claimed_at": {"type": "string", "format": "date-time"},
    "claim_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
