{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admission-Bound Native Supervision Pool Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type", "version", "schema", "pool_id", "pool_epoch", "control_turn_id",
    "created_at", "owner", "children", "max_active_workers", "scheduler",
    "aggregate_hard_budget", "topology", "allowed_actions",
    "capability_receipt_sha256", "completion_policy", "contract_sha256",
    "admission_reservation_sha256", "readiness_snapshot_sha256",
    "readiness_evidence_sha256", "work_estimate_set_sha256",
    "native_worker_policy_sha256", "proportionality_policy_sha256",
    "proportionality_assessment_sha256", "selected_cohort_sha256",
    "fixed_cohort_sha256", "child_bindings_sha256", "claim_set_sha256"
  ],
  "properties": {
    "contract_type": {"const": "cwo-native-supervision-pool-contract"},
    "version": {"const": 2},
    "schema": {"const": "schemas/native-supervision-pool-contract-v2.schema.json"},
    "pool_id": {"type": "string", "minLength": 1},
    "pool_epoch": {"type": "string", "minLength": 1},
    "control_turn_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "owner": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/owner"},
    "children": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/child"}},
    "max_active_workers": {"enum": [1, 2, 3]},
    "scheduler": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/scheduler"},
    "aggregate_hard_budget": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/budget"},
    "topology": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/topology"},
    "allowed_actions": {"const": ["admit", "step", "interrupt", "close", "finalize", "release-leases"]},
    "capability_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "completion_policy": {"enum": ["all-or-nothing", "best-effort"]},
    "admission_reservation_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "readiness_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "work_estimate_set_sha256": {"$ref": "#/$defs/sha256"},
    "native_worker_policy_sha256": {"$ref": "#/$defs/sha256"},
    "proportionality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "proportionality_assessment_sha256": {"$ref": "#/$defs/sha256"},
    "selected_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "fixed_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "child_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "claim_set_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"max_active_workers": {"const": 1}}},
      "then": {
        "properties": {
          "children": {"minItems": 1, "maxItems": 1},
          "scheduler": {"properties": {"certified_max_check_ms": {"type": "null"}, "certified_max_scheduler_overhead_ms": {"type": "null"}}},
          "capability_receipt_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"max_active_workers": {"const": 2}}},
      "then": {"properties": {"children": {"minItems": 2, "maxItems": 2}, "capability_receipt_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {"properties": {"max_active_workers": {"const": 3}}},
      "then": {"properties": {"children": {"minItems": 3, "maxItems": 3}, "capability_receipt_sha256": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "child_id", "packet_id", "attempt_nonce", "session_id", "agent_id",
        "control_turn_id", "packet_sha256", "control_contract_sha256", "state_file",
        "worktree_identity", "isolation_class", "completion_evidence_policy", "tool_policy",
        "declared_write_paths", "integration_target_paths", "lease_id",
        "bead_id", "work_unit_id", "candidate_sha256", "claim_sha256",
        "work_estimate_sha256", "worker_commitment_sha256", "lease_scope_sha256",
        "worktree_identity_sha256", "admitted_child_sha256", "hard_budget",
        "requested_model", "packet_binding_sha256", "lease_binding_sha256",
        "path_binding_sha256", "budget_binding_sha256", "tool_binding_sha256",
        "model_binding_sha256", "session_binding_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "child_id": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "attempt_nonce": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "control_turn_id": {"type": "string", "minLength": 1},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "control_contract_sha256": {"$ref": "#/$defs/sha256"},
        "state_file": {"type": "string", "pattern": "^/", "minLength": 2},
        "worktree_identity": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/identity"},
        "isolation_class": {"enum": ["read-only-shared", "mutable-isolated"]},
        "completion_evidence_policy": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/completion_evidence_policy"},
        "tool_policy": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/tool_policy"},
        "declared_write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "integration_target_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "lease_id": {"type": "string", "minLength": 1},
        "bead_id": {"type": "string", "minLength": 1},
        "work_unit_id": {"type": "string", "minLength": 1},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "claim_sha256": {"$ref": "#/$defs/sha256"},
        "work_estimate_sha256": {"$ref": "#/$defs/sha256"},
        "worker_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "lease_scope_sha256": {"$ref": "#/$defs/sha256"},
        "worktree_identity_sha256": {"$ref": "#/$defs/sha256"},
        "admitted_child_sha256": {"$ref": "#/$defs/sha256"},
        "hard_budget": {"$ref": "native-supervision-pool-contract.schema.json#/$defs/budget"},
        "requested_model": {"type": "string", "minLength": 1},
        "packet_binding_sha256": {"$ref": "#/$defs/sha256"},
        "lease_binding_sha256": {"$ref": "#/$defs/sha256"},
        "path_binding_sha256": {"$ref": "#/$defs/sha256"},
        "budget_binding_sha256": {"$ref": "#/$defs/sha256"},
        "tool_binding_sha256": {"$ref": "#/$defs/sha256"},
        "model_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
