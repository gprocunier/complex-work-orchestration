{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sprint Continuation Result",
  "type": "object",
  "required": [
    "continuation_result_type",
    "version",
    "source",
    "durability",
    "epic_id",
    "sprint_id",
    "sprint_goal",
    "modeling_note",
    "recommended_next_issue",
    "why_next",
    "ready_issues",
    "blocked_issues",
    "carry_forward",
    "definition_of_ready",
    "definition_of_done",
    "evidence_expectations",
    "resume_commands",
    "operator_handoff_packet",
    "warnings"
  ],
  "properties": {
    "continuation_result_type": {"const": "complex-work-orchestration-sprint-continuation"},
    "version": {"enum": [1, 2]},
    "source": {"enum": ["beads", "markdown-workgraph"]},
    "durability": {"enum": ["durable", "reduced"]},
    "epic_id": {"type": "string"},
    "sprint_id": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "sprint_goal": {"type": "string"},
    "modeling_note": {"type": "string"},
    "recommended_next_issue": {
      "anyOf": [
        {"$ref": "#/$defs/issue"},
        {"type": "null"}
      ]
    },
    "why_next": {"type": "string"},
    "ready_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "ranked_ready_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "recommended_ready_set": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/ready_candidate"}
    },
    "compatible_ready_sets": {
      "type": "array",
      "items": {"$ref": "#/$defs/compatible_ready_set"}
    },
    "excluded_ready_issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/excluded_issue"}
    },
    "beads_readiness_snapshot": {
      "oneOf": [
        {"$ref": "#/$defs/readiness_snapshot"},
        {"type": "null"}
      ]
    },
    "beads_readiness_snapshot_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "fanout_decision": {"enum": ["single", "pool", "blocked"]},
    "fanout_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fanout_reason"}
    },
    "candidate_capacity_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/candidate_capacity_evidence"},
        {"type": "null"}
      ]
    },
    "ready_set_authority": {"const": "candidate-evidence-only"},
    "dispatch_authorized": {"const": false},
    "blocked_issues": {"type": "array", "items": {"$ref": "#/$defs/blocked_issue"}},
    "carry_forward": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "definition_of_ready": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "definition_of_done": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "evidence_expectations": {"type": "array", "items": {"type": "string"}},
    "resume_commands": {"type": "array", "items": {"type": "string"}},
    "operator_handoff_packet": {
      "type": "object",
      "required": [
        "next_executable_bead",
        "why_it_is_next",
        "exact_command_resume",
        "execution_prompt",
        "what_must_not_run_yet",
        "commit_push_status",
        "validation_status",
        "escalation_rule"
      ],
      "properties": {
        "next_executable_bead": {"type": "string", "minLength": 1},
        "why_it_is_next": {"type": "string", "minLength": 1},
        "exact_command_resume": {"type": "string", "minLength": 1},
        "execution_prompt": {"type": "string", "minLength": 1},
        "what_must_not_run_yet": {"type": "string", "minLength": 1},
        "commit_push_status": {"type": "string", "minLength": 1},
        "validation_status": {"type": "string", "minLength": 1},
        "escalation_rule": {"type": "string", "minLength": 1}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"version": {"const": 2}}, "required": ["version"]},
      "then": {
        "required": [
          "ranked_ready_issues",
          "recommended_ready_set",
          "compatible_ready_sets",
          "excluded_ready_issues",
          "beads_readiness_snapshot",
          "beads_readiness_snapshot_sha256",
          "fanout_decision",
          "fanout_reasons",
          "candidate_capacity_evidence",
          "ready_set_authority",
          "dispatch_authorized"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue": {
      "type": "object",
      "required": ["id", "title", "type", "status", "labels", "priority", "dependencies"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "status": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "integer"},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "blocked_issue": {
      "type": "object",
      "required": ["id", "title", "type", "status", "labels", "priority", "dependencies", "blockers"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "status": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "integer"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "budget": {
      "type": "object",
      "required": ["tool_calls", "runtime_seconds", "compactions", "full_suite_runs", "mutations"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": "integer", "minimum": 0},
        "compactions": {"type": "integer", "minimum": 0},
        "full_suite_runs": {"type": "integer", "minimum": 0},
        "mutations": {"type": "integer", "minimum": 0}
      }
    },
    "ready_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "work_estimate_sha256",
        "worker_commitment_sha256",
        "admission_metadata_sha256",
        "declared_read_paths",
        "declared_write_paths",
        "integration_target_paths",
        "protected_domains",
        "topology",
        "isolation_class",
        "architecture_authority",
        "execution_authority",
        "share_boundary",
        "requested_model",
        "required_tools",
        "tool_surface_id",
        "tool_policy_sha256",
        "tool_surface_sha256",
        "capability_receipt_sha256",
        "capability_assessed_at",
        "lease_scope_sha256",
        "integration_root_identity_sha256",
        "workspace_scope_sha256",
        "authority_approval_audit_sha256",
        "hard_budget",
        "aggregate_hard_budget",
        "candidate_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 0},
        "work_estimate_sha256": {"$ref": "#/$defs/sha256"},
        "worker_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "admission_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "declared_read_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "declared_write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "integration_target_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "protected_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "topology": {"type": "string", "minLength": 1},
        "isolation_class": {"enum": ["read-only-shared", "mutable-isolated"]},
        "architecture_authority": {"type": "string", "minLength": 1},
        "execution_authority": {"type": "string", "minLength": 1},
        "share_boundary": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tool_surface_id": {"type": "string", "minLength": 1},
        "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
        "tool_surface_sha256": {"$ref": "#/$defs/sha256"},
        "capability_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "capability_assessed_at": {"type": "string", "format": "date-time"},
        "lease_scope_sha256": {"$ref": "#/$defs/sha256"},
        "integration_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_scope_sha256": {"$ref": "#/$defs/sha256"},
        "authority_approval_audit_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "hard_budget": {"$ref": "#/$defs/budget"},
        "aggregate_hard_budget": {"$ref": "#/$defs/budget"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatible_ready_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_type",
        "version",
        "snapshot_sha256",
        "issue_ids",
        "candidate_sha256s",
        "worker_count",
        "within_released_capacity",
        "authority",
        "dispatch_authorized",
        "cohort_sha256"
      ],
      "properties": {
        "cohort_type": {"const": "cwo-compatible-ready-set"},
        "version": {"const": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "issue_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "worker_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "within_released_capacity": {"type": "boolean"},
        "authority": {"const": "candidate-evidence-only"},
        "dispatch_authorized": {"const": false},
        "cohort_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatible_ready_set_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_ids",
        "candidate_sha256s",
        "worker_count",
        "within_released_capacity"
      ],
      "properties": {
        "issue_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "worker_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "within_released_capacity": {"type": "boolean"}
      }
    },
    "exclusion_reason": {
      "type": "object",
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "excluded_issue": {
      "type": "object",
      "required": ["id", "reasons"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exclusion_reason"}}
      }
    },
    "fanout_reason": {
      "type": "object",
      "required": ["code", "issue_ids", "provenance", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "issue_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "evidence": {"type": "array"}
      }
    },
    "readiness_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_type",
        "version",
        "epic_id",
        "canonical_ready_issue_ids",
        "ranked_ready_issue_ids",
        "scope_issue_ids",
        "issue_projections",
        "native_worker_policy_sha256",
        "share_boundaries_policy_sha256",
        "candidate_capacity_basis",
        "compatible_ready_set_commitments",
        "snapshot_sha256"
      ],
      "properties": {
        "snapshot_type": {"const": "cwo-beads-ready-set-snapshot:v2"},
        "version": {"const": 2},
        "epic_id": {"type": "string", "minLength": 1},
        "canonical_ready_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ranked_ready_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scope_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "issue_projections": {
          "type": "array",
          "items": {"$ref": "#/$defs/issue_projection"}
        },
        "native_worker_policy_sha256": {"$ref": "#/$defs/sha256"},
        "share_boundaries_policy_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_capacity_basis": {"$ref": "#/$defs/candidate_capacity_basis"},
        "compatible_ready_set_commitments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/compatible_ready_set_commitment"}
        },
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependency_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "blocking", "status", "updated_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "status": {"type": "string", "minLength": 1},
        "updated_at": {"type": ["string", "null"]}
      }
    },
    "candidate_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_estimate_sha256",
        "worker_commitment_sha256",
        "admission_metadata_sha256",
        "capability_receipt_sha256",
        "tool_policy_sha256",
        "tool_surface_sha256",
        "lease_scope_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "work_estimate_sha256": {"$ref": "#/$defs/sha256"},
        "worker_commitment_sha256": {"$ref": "#/$defs/sha256"},
        "admission_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "capability_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
        "tool_surface_sha256": {"$ref": "#/$defs/sha256"},
        "lease_scope_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "issue_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "status",
        "updated_at",
        "exact_show_raw_sha256",
        "type",
        "priority",
        "labels",
        "assignee",
        "owner",
        "parent",
        "lane",
        "dependency_projection",
        "ranking_dependencies",
        "canonical_ready",
        "canonical_ready_rank",
        "candidate_rank",
        "executable_leaf",
        "admission_metadata_sha256",
        "candidate_artifacts",
        "issue_projection_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "status": {"type": "string", "minLength": 1},
        "updated_at": {"type": ["string", "null"]},
        "exact_show_raw_sha256": {"$ref": "#/$defs/sha256"},
        "type": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"},
        "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assignee": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "parent": {"type": ["string", "null"]},
        "lane": {"type": ["string", "null"]},
        "dependency_projection": {"type": "array", "items": {"$ref": "#/$defs/dependency_projection"}},
        "ranking_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "canonical_ready": {"type": "boolean"},
        "canonical_ready_rank": {"type": ["integer", "null"], "minimum": 0},
        "candidate_rank": {"type": ["integer", "null"], "minimum": 0},
        "executable_leaf": {"type": "boolean"},
        "admission_metadata_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "candidate_artifacts": {
          "oneOf": [{"$ref": "#/$defs/candidate_artifacts"}, {"type": "null"}]
        },
        "issue_projection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_capacity_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_workers",
        "released_max_active_workers",
        "hard_max_active_workers",
        "phase1_candidate_ceiling",
        "bounded_candidate_capacity",
        "released_capacity_is_dispatch_gate",
        "schedulability_proofs"
      ],
      "properties": {
        "requested_workers": {"type": "integer", "minimum": 1},
        "released_max_active_workers": {"type": "integer", "minimum": 1},
        "hard_max_active_workers": {"type": "integer", "minimum": 1},
        "phase1_candidate_ceiling": {"const": 3},
        "bounded_candidate_capacity": {"type": "integer", "minimum": 1, "maximum": 3},
        "released_capacity_is_dispatch_gate": {"const": true},
        "schedulability_proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "object"}
        }
      }
    },
    "candidate_capacity_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_workers",
        "released_max_active_workers",
        "hard_max_active_workers",
        "phase1_candidate_ceiling",
        "bounded_candidate_capacity",
        "released_capacity_is_dispatch_gate",
        "schedulability_proofs",
        "selected_workers",
        "selected_exceeds_released_capacity",
        "selected_within_released_capacity"
      ],
      "properties": {
        "requested_workers": {"type": "integer", "minimum": 1},
        "released_max_active_workers": {"type": "integer", "minimum": 1},
        "hard_max_active_workers": {"type": "integer", "minimum": 1},
        "phase1_candidate_ceiling": {"const": 3},
        "bounded_candidate_capacity": {"type": "integer", "minimum": 1, "maximum": 3},
        "released_capacity_is_dispatch_gate": {"const": true},
        "schedulability_proofs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "object"}
        },
        "selected_workers": {"type": "integer", "minimum": 0, "maximum": 3},
        "selected_exceeds_released_capacity": {"type": "boolean"},
        "selected_within_released_capacity": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "required": ["criterion", "status", "evidence"],
      "properties": {
        "criterion": {"type": "string"},
        "status": {"enum": ["met", "missing", "review", "pending"]},
        "evidence": {"type": "string"}
      }
    }
  }
}
