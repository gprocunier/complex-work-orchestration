{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Replanning State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_type",
    "version",
    "schema",
    "main_thread",
    "state",
    "work_unit_id",
    "bead_id",
    "packet_id",
    "requested_model",
    "objective",
    "security_context",
    "authority_provenance",
    "model_match",
    "control_healthy",
    "counters",
    "aggregate_allowance",
    "mutation",
    "terminal_latches",
    "reason_codes",
    "protected_change_authorizations",
    "next_action",
    "cwo_native_replanning_receipt",
    "policy_snapshot",
    "state_sha256"
  ],
  "properties": {
    "result_type": {
      "type": "string",
      "const": "cwo-native-replanning-state"
    },
    "version": {
      "type": "integer",
      "const": 3
    },
    "schema": {
      "type": "string",
      "const": "schemas/native-replanning-state.schema.json"
    },
    "main_thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort",
        "source",
        "recommended_effort",
        "recommendation_reason",
        "advisory",
        "user_selected_effort_retained"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "recommended_effort": {
          "type": "string",
          "minLength": 1
        },
        "recommendation_reason": {
          "type": "string",
          "minLength": 1
        },
        "advisory": {
          "type": "boolean"
        },
        "user_selected_effort_retained": {
          "type": "boolean"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "commitment-required",
        "dispatchable",
        "executing",
        "pm-realignment",
        "architect-realignment",
        "reassignment-ready",
        "protected-stop",
        "completed"
      ]
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "bead_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "security_context": {
      "type": "string",
      "minLength": 1
    },
    "authority_provenance": {"$ref": "#/$defs/authority_provenance"},
    "model_match": {
      "type": "boolean"
    },
    "control_healthy": {
      "type": "boolean"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatches",
        "tool_calls_used",
        "runtime_seconds_used",
        "context_compactions",
        "pm_replans_used",
        "architect_cycles_used"
      ],
      "properties": {
        "dispatches": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_used": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_used": {
          "type": "integer",
          "minimum": 0
        },
        "context_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "pm_replans_used": {
          "type": "integer",
          "minimum": 0
        },
        "architect_cycles_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "aggregate_allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls_hard",
        "runtime_seconds_hard",
        "dispatch_soft_cap",
        "dispatch_soft_cap_action",
        "max_pm_replans",
        "max_architect_cycles",
        "max_compactions"
      ],
      "properties": {
        "tool_calls_hard": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_seconds_hard": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch_soft_cap": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch_soft_cap_action": {
          "type": "string",
          "minLength": 1
        },
        "max_pm_replans": {
          "type": "integer",
          "minimum": 0
        },
        "max_architect_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "max_compactions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["out_of_scope", "tainted"],
      "properties": {
        "out_of_scope": {
          "type": "boolean"
        },
        "tainted": {
          "type": "boolean"
        }
      }
    },
    "terminal_latches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tainted", "contradictory_validation"],
      "properties": {
        "tainted": {"type": "boolean"},
        "contradictory_validation": {"type": "boolean"}
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_change_authorizations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operator_approval_audit"}
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_soft_cap",
        "max_pm_replans",
        "max_architect_cycles",
        "max_compactions",
        "live_replay_enabled"
      ],
      "properties": {
        "dispatch_soft_cap": {
          "type": "integer",
          "minimum": 0
        },
        "max_pm_replans": {
          "type": "integer",
          "minimum": 0
        },
        "max_architect_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "max_compactions": {
          "type": "integer",
          "minimum": 0
        },
        "live_replay_enabled": {
          "type": "boolean"
        }
      }
    },
    "state_sha256": {"$ref": "#/$defs/sha256"},
    "cwo_native_replanning_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "version",
        "schema",
        "state_before",
        "main_thread",
        "state_after",
        "event",
        "authority_provenance",
        "reason_records",
        "protected_change_authorizations",
        "decision",
        "reason_codes",
        "work_unit_id",
        "bead_id",
        "packet_id",
        "counters",
        "aggregate",
        "mutation",
        "terminal_latches",
        "model_health",
        "control_health",
        "next_action",
        "state_sha256"
      ],
      "properties": {
        "result_type": {
          "type": "string",
          "const": "cwo-native-replanning-receipt"
        },
        "main_thread": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "effort",
            "source",
            "recommended_effort",
            "recommendation_reason",
            "advisory",
            "user_selected_effort_retained"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "recommended_effort": {
              "type": "string",
              "minLength": 1
            },
            "recommendation_reason": {
              "type": "string",
              "minLength": 1
            },
            "advisory": {
              "type": "boolean"
            },
            "user_selected_effort_retained": {
              "type": "boolean"
            }
          }
        },
        "version": {
          "type": "integer",
          "const": 3
        },
        "schema": {
          "type": "string",
          "const": "schemas/native-replanning-state.schema.json"
        },
        "state_before": {
          "type": "string",
          "minLength": 1
        },
        "state_after": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "authority_provenance": {"$ref": "#/$defs/authority_provenance"},
        "reason_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/reason_record"}
        },
        "protected_change_authorizations": {
          "type": "array",
          "items": {"$ref": "#/$defs/operator_approval_audit"}
        },
        "decision": {
          "type": "string",
          "enum": [
            "initialized",
            "advance",
            "replan",
            "complete",
            "protected-stop"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "bead_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dispatches",
            "tool_calls_used",
            "runtime_seconds_used",
            "context_compactions",
            "pm_replans_used",
            "architect_cycles_used",
            "tool_calls_remaining",
            "runtime_seconds_remaining",
            "dispatches_remaining"
          ],
          "properties": {
            "dispatches": {
              "type": "integer",
              "minimum": 0
            },
            "tool_calls_used": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_seconds_used": {
              "type": "integer",
              "minimum": 0
            },
            "context_compactions": {
              "type": "integer",
              "minimum": 0
            },
            "pm_replans_used": {
              "type": "integer",
              "minimum": 0
            },
            "architect_cycles_used": {
              "type": "integer",
              "minimum": 0
            },
            "tool_calls_remaining": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_seconds_remaining": {
              "type": "integer",
              "minimum": 0
            },
            "dispatches_remaining": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_calls_hard",
            "runtime_seconds_hard",
            "dispatch_soft_cap",
            "dispatch_soft_cap_action",
            "max_pm_replans",
            "max_architect_cycles",
            "max_compactions"
          ],
          "properties": {
            "tool_calls_hard": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_seconds_hard": {
              "type": "integer",
              "minimum": 0
            },
            "dispatch_soft_cap": {
              "type": "integer",
              "minimum": 0
            },
            "dispatch_soft_cap_action": {
              "type": "string",
              "minLength": 1
            },
            "max_pm_replans": {
              "type": "integer",
              "minimum": 0
            },
            "max_architect_cycles": {
              "type": "integer",
              "minimum": 0
            },
            "max_compactions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["out_of_scope", "tainted"],
          "properties": {
            "out_of_scope": {
              "type": "boolean"
            },
            "tainted": {
              "type": "boolean"
            }
          }
        },
        "terminal_latches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tainted", "contradictory_validation"],
          "properties": {
            "tainted": {"type": "boolean"},
            "contradictory_validation": {"type": "boolean"}
          }
        },
        "model_health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_model"],
          "properties": {
            "exact_model": {
              "type": "boolean"
            }
          }
        },
        "control_health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["healthy"],
          "properties": {
            "healthy": {
              "type": "boolean"
            }
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "state_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "source_type", "source_id", "source_sha256", "actor_id",
        "actor_role", "identity_source", "authorized_scope",
        "parent_receipt_sha256", "verification", "authority_sha256"
      ],
      "properties": {
        "version": {"const": 1},
        "source_type": {
          "enum": [
            "worker-discovery", "pm-observation", "architect-judgment",
            "operator-directive", "policy-enforcement"
          ]
        },
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {
          "enum": [
            "operative-worker", "critic", "project-manager", "architect",
            "supervisor-policy", "operator"
          ]
        },
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {
          "enum": ["child", "cohort", "execution-path", "complete-task", "publication"]
        },
        "parent_receipt_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operator_approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_type", "version", "approval_id", "change_type",
        "before_sha256", "after_sha256", "actor_id", "identity_source",
        "authorized_scope", "parent_receipt_sha256", "issued_at", "expires_at",
        "nonce", "signature"
      ],
      "properties": {
        "approval_type": {"const": "cwo-operator-protected-change-approval"},
        "version": {"const": 1},
        "approval_id": {"type": "string", "minLength": 1},
        "change_type": {
          "enum": [
            "aggregate-budget-increase", "model-substitution", "objective-change",
            "security-or-authority-change", "tainted-mutation-acceptance",
            "contradictory-validation"
          ]
        },
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {"enum": ["complete-task", "publication"]},
        "parent_receipt_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "issued_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "nonce": {"type": "string", "minLength": 1},
        "signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "operator_approval_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_type", "version", "approval_id", "change_type",
        "before_sha256", "after_sha256", "issued_at", "expires_at",
        "nonce", "receipt_sha256", "signed_receipt", "authority_provenance"
      ],
      "properties": {
        "approval_type": {"const": "cwo-operator-protected-change-approval"},
        "version": {"const": 1},
        "approval_id": {"type": "string", "minLength": 1},
        "change_type": {
          "enum": [
            "aggregate-budget-increase", "model-substitution", "objective-change",
            "security-or-authority-change", "tainted-mutation-acceptance",
            "contradictory-validation"
          ]
        },
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "nonce": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "signed_receipt": {"$ref": "#/$defs/operator_approval_receipt"},
        "authority_provenance": {"$ref": "#/$defs/authority_provenance"}
      }
    },
    "reason_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "authority_provenance", "detected_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "authority_provenance": {"$ref": "#/$defs/authority_provenance"},
        "detected_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
