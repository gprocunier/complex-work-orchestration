{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/native-tool-activation-plan.schema.json",
  "title": "CWO native tool activation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_type",
    "version",
    "schema",
    "activation_id",
    "profile",
    "prepared_at",
    "expires_at",
    "source_repository",
    "candidate_commit",
    "candidate_tree",
    "control_root",
    "run_root",
    "launch_id",
    "pool_id",
    "pool_epoch",
    "campaign_nonce",
    "requested_workers",
    "mutating_workers",
    "risk_acknowledgement",
    "paths",
    "override",
    "epic_id",
    "tasks",
    "readiness_evidence",
    "work_estimates",
    "proportionality_assessment",
    "child_bindings",
    "activation_request",
    "activation_artifacts",
    "plan_sha256"
  ],
  "properties": {
    "plan_type": {"const": "cwo-native-tool-activation-plan"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-tool-activation-plan.schema.json"},
    "activation_id": {"type": "string", "format": "uuid"},
    "profile": {
      "enum": ["n1-read-only", "n2-read-only", "n1-mutable"]
    },
    "prepared_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "source_repository": {"type": "string", "minLength": 1},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_root": {"type": "string", "minLength": 1},
    "run_root": {"type": "string", "minLength": 1},
    "launch_id": {"type": "string", "format": "uuid"},
    "pool_id": {"type": "string", "format": "uuid"},
    "pool_epoch": {"type": "string", "format": "uuid"},
    "campaign_nonce": {"type": "string", "format": "uuid"},
    "requested_workers": {"type": "integer", "minimum": 1, "maximum": 2},
    "mutating_workers": {"type": "integer", "minimum": 0, "maximum": 1},
    "risk_acknowledgement": {
      "const": "unlisted-built-ins-may-act-before-detection"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "integration",
        "beads_directory",
        "beads_database",
        "claims",
        "ledger",
        "leases",
        "pool_state",
        "pool_decision",
        "approval",
        "approval_replay",
        "result"
      ],
      "properties": {
        "records": {"type": "string", "minLength": 1},
        "integration": {"type": "string", "minLength": 1},
        "beads_directory": {"type": "string", "minLength": 1},
        "beads_database": {"type": "string", "minLength": 1},
        "claims": {"type": "string", "minLength": 1},
        "ledger": {"type": "string", "minLength": 1},
        "leases": {"type": "string", "minLength": 1},
        "pool_state": {"type": "string", "minLength": 1},
        "pool_decision": {"type": "string", "minLength": 1},
        "approval": {"type": "string", "minLength": 1},
        "approval_replay": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1}
      }
    },
    "override": {"type": "object"},
    "epic_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "readiness_evidence": {"type": "object"},
    "work_estimates": {"type": "object"},
    "proportionality_assessment": {"type": "object"},
    "child_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "object"}
    },
    "activation_request": {"type": "object"},
    "activation_artifacts": {"type": "object"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
