{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Dispatch Envelope",
  "type": "object",
  "required": [
    "envelope_type",
    "version",
    "envelope_version",
    "dispatch_id",
    "environment",
    "mode",
    "harness",
    "role",
    "lifecycle_state",
    "prompt",
    "prompt_sha256",
    "suggested_command",
    "capability_requirements",
    "execution_enabled",
    "timeout_seconds",
    "constraints"
  ],
  "properties": {
    "envelope_type": {"const": "harness-dispatch"},
    "version": {"type": "integer"},
    "envelope_version": {"type": "string"},
    "dispatch_id": {"type": "string"},
    "bead_id": {"type": ["string", "null"]},
    "epic_id": {"type": ["string", "null"]},
    "environment": {"type": "string"},
    "mode": {"type": "string"},
    "harness": {"type": "string"},
    "role": {"type": "string"},
    "lifecycle_state": {"enum": ["rendered", "accepted", "running", "completed", "failed", "rejected"]},
    "agent": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "variant": {"type": ["string", "null"]},
    "prompt": {"type": "string"},
    "prompt_sha256": {"type": "string"},
    "suggested_command": {"type": "string"},
    "capability_requirements": {"type": "object"},
    "execution_enabled": {"type": "boolean"},
    "timeout_seconds": {"type": "integer"},
    "constraints": {"type": "object"},
    "harness_capabilities": {"type": "object"}
  }
}
