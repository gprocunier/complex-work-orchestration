{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bound Peer Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "version",
    "reviewer_identity",
    "return_sha256",
    "evaluation_sha256",
    "decision"
  ],
  "properties": {
    "record_type": {
      "const": "cwo-peer-review"
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "reviewer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_family",
        "model_id",
        "reasoning_effort",
        "dispatch_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "model_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
        }
      }
    },
    "return_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "const": "passed"
    }
  }
}
