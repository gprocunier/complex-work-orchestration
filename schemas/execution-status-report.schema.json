{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Execution Status Report",
  "type": "object",
  "required": [
    "result_type",
    "version",
    "authority",
    "canonical_source",
    "source_counts",
    "executive_summary",
    "expert_profile_utilization",
    "expert_profile_utilization_details",
    "agent_model_utilization",
    "agent_model_utilization_details",
    "main_thread_architect_productivity",
    "workerbee_delegation_accountability",
    "workerbee_delegation_summary",
    "workerbee_delegation_details",
    "native_disposition_summary",
    "native_disposition_details",
    "native_supervision_summary",
    "native_supervision_details",
    "call_category_summary",
    "epic_convergence_summary",
    "sol_breakfix_summary",
    "second_opinion_review_lane_productivity",
    "second_opinion_review_lane_productivity_details",
    "telemetry_gaps",
    "quality_malpractice_sabotage_summary",
    "evidence_disposition_summary"
  ],
  "properties": {
    "result_type": {"const": "cwo-execution-status-report"},
    "version": {"type": "integer", "minimum": 1},
    "authority": {"const": "projection"},
    "canonical_source": {"type": "string"},
    "source_counts": {"type": "object"},
    "source_files": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "executive_summary": {"type": "object"},
    "expert_profile_utilization": {"type": "array", "items": {"type": "object"}},
    "expert_profile_utilization_details": {"type": "array", "items": {"type": "object"}},
    "agent_model_utilization": {"type": "array", "items": {"type": "object"}},
    "agent_model_utilization_details": {"type": "array", "items": {"type": "object"}},
    "main_thread_architect_productivity": {"type": "object"},
    "workerbee_delegation_accountability": {"type": "object"},
    "workerbee_delegation_summary": {"type": "object"},
    "workerbee_delegation_details": {"type": "array", "items": {"type": "object"}},
    "native_disposition_summary": {"type": "object"},
    "native_disposition_details": {"type": "array", "items": {"type": "object"}},
    "native_supervision_summary": {"type": "object"},
    "native_supervision_details": {"type": "array", "items": {"type": "object"}},
    "call_category_summary": {"type": "object"},
    "epic_convergence_summary": {"type": "object"},
    "sol_breakfix_summary": {"type": "object"},
    "second_opinion_review_lane_productivity": {"type": "array", "items": {"type": "object"}},
    "second_opinion_review_lane_productivity_details": {"type": "array", "items": {"type": "object"}},
    "telemetry_gaps": {
      "type": "object",
      "required": [
        "records_considered",
        "source_artifacts_supplied",
        "fields_with_missing_values",
        "fields"
      ],
      "properties": {
        "records_considered": {"type": "integer", "minimum": 0},
        "source_artifacts_supplied": {"type": "boolean"},
        "fields_with_missing_values": {"type": "array", "items": {"type": "string"}},
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "available_records",
              "missing_records",
              "not_applicable_records",
              "missing_source_kinds",
              "missing_reasons",
              "by_source_kind"
            ],
            "properties": {
              "available_records": {"type": "integer", "minimum": 0},
              "missing_records": {"type": "integer", "minimum": 0},
              "not_applicable_records": {"type": "integer", "minimum": 0},
              "missing_source_kinds": {"type": "array", "items": {"type": "string"}},
              "missing_reasons": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 0}
              },
              "by_source_kind": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["available_records", "missing_records", "not_applicable_records"],
                  "properties": {
                    "available_records": {"type": "integer", "minimum": 0},
                    "missing_records": {"type": "integer", "minimum": 0},
                    "not_applicable_records": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "quality_malpractice_sabotage_summary": {"type": "object"},
    "evidence_disposition_summary": {"type": "object"}
  }
}
