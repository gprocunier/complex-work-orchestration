{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestration Beads Metadata",
  "type": "object",
  "required": ["executor", "dispatch_mode", "share_boundary", "architect_review_required"],
  "properties": {
    "executor": {"type": "string"},
    "selected_executor": {"type": "object"},
    "executor_policy_violations": {"type": "array", "items": {"type": "string"}},
    "dispatch_mode": {"type": "string"},
    "task_class": {"type": "string"},
    "review_stage": {"type": "string"},
    "required_experts": {"type": "array", "items": {"type": "string"}},
    "share_boundary": {"type": "string"},
    "data_sensitivity": {"type": "string"},
    "dispatch_sensitivity": {"type": "string"},
    "expert_profile_included": {"type": "boolean"},
    "external_opt_in": {"type": "boolean"},
    "opt_in_basis": {"type": "string"},
    "quota_checked": {"type": "boolean"},
    "quota_remaining": {"type": ["integer", "null"]},
    "codex_pickup": {"type": "string"},
    "architect_review_required": {"type": "boolean"},
    "acceptance_bead_required": {"type": "boolean"}
  }
}
