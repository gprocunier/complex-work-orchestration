{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Worker Supervision State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_type", "version", "schema", "state_id", "packet_id", "packet_sha256",
    "packet_file", "bead_id", "lane", "agent_id", "session_id", "session_file", "baseline_record_count", "requested_model", "budget",
    "budget_provenance", "interrupt_thresholds", "poll_interval_ms", "poll_lag_tolerance_ms", "arm_to_dispatch_max_ms",
    "control_turn_required", "segment_start_grace_seconds", "control_adapter",
    "immutable_work_sha256", "recovery",
    "required_capabilities", "validation_lineage", "audit_file", "control_turn_id", "submission_id", "control_timing", "status", "decision", "reasons", "reason_records",
    "control_action_required", "control_receipts", "observed", "session_disposition",
    "artifact_disposition", "artifact_validation", "trailing_partial_record_ignored",
    "started_at", "updated_at", "finalized_at", "last_audited_decision",
    "stop_scope", "authorized_continuation_paths", "scope_authority"
  ],
  "properties": {
    "result_type": {"const": "cwo-native-supervision-state"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-supervision-state.schema.json"},
    "state_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "minLength": 64},
    "packet_file": {"type": "string", "minLength": 1},
    "bead_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["implementation", "validation", "review", "publish-report-admin"]},
    "agent_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "session_file": {"type": "string", "minLength": 1},
    "baseline_record_count": {"type": "integer", "minimum": 1},
    "requested_model": {"enum": ["gpt-5.3-codex-spark", "gpt-5.6-luna"]},
    "budget": {"type": "object"},
    "budget_provenance": {"type": "object"},
    "interrupt_thresholds": {"type": "object"},
    "poll_interval_ms": {"type": "integer", "minimum": 100},
    "poll_lag_tolerance_ms": {"type": "integer", "minimum": 0},
    "arm_to_dispatch_max_ms": {"type": "integer", "minimum": 100},
    "control_turn_required": {"const": true},
    "segment_start_grace_seconds": {"type": "integer", "minimum": 1},
    "control_adapter": {"const": "native-multi-agent-v1"},
    "required_capabilities": {"const": ["interrupt", "close", "wait"]},
    "validation_lineage": {"type": "object"},
    "audit_file": {"type": "string", "minLength": 1},
    "control_turn_id": {"type": ["string", "null"]},
    "submission_id": {"type": ["string", "null"]},
    "control_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monitor_armed_before_dispatch", "armed_at", "dispatched_at", "first_poll_at", "last_poll_at", "arm_to_dispatch_ms", "dispatch_to_first_poll_ms", "max_poll_gap_ms", "late_poll_count"],
      "properties": {
        "monitor_armed_before_dispatch": {"type": "boolean"},
        "armed_at": {"type": ["string", "null"]},
        "dispatched_at": {"type": ["string", "null"]},
        "first_poll_at": {"type": ["string", "null"]},
        "last_poll_at": {"type": ["string", "null"]},
        "arm_to_dispatch_ms": {"type": ["integer", "null"], "minimum": 0},
        "dispatch_to_first_poll_ms": {"type": ["integer", "null"], "minimum": 0},
        "max_poll_gap_ms": {"type": "integer", "minimum": 0},
        "late_poll_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["created", "armed", "running", "interrupt-pending", "interrupt-confirmed", "completed", "closed", "control-failed"]},
    "decision": {"enum": ["continue", "warn", "interrupt", "complete", "control-lost"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "reason_records": {"type": "array", "items": {"$ref": "#/$defs/reason_record"}},
    "immutable_work_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "cumulative_usage", "eligibility", "authorization"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 0, "maximum": 1},
        "cumulative_usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_calls", "runtime_seconds"],
          "properties": {
            "tool_calls": {"type": "integer", "minimum": 0},
            "runtime_seconds": {"type": "integer", "minimum": 0}
          }
        },
        "eligibility": {"type": ["object", "null"]},
        "authorization": {"type": ["object", "null"]}
      }
    },
    "control_action_required": {"type": "boolean"},
    "control_receipts": {"type": "array", "items": {"type": "string"}},
    "observed": {"type": "object"},
    "session_disposition": {"enum": ["accepted", "accepted-with-warning", "quarantined"]},
    "artifact_disposition": {"enum": ["accepted", "independent-validation-required", "architect-adjudication-required", "rejected"]},
    "artifact_validation": {"type": "object"},
    "trailing_partial_record_ignored": {"type": "boolean"},
    "started_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "finalized_at": {"type": ["string", "null"]},
    "last_audited_decision": {"enum": ["continue", "warn", "interrupt", "complete", "control-lost"]},
    "stop_scope": {"$ref": "#/$defs/stop_scope"},
    "authorized_continuation_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/continuation_path"}},
    "scope_authority": {"$ref": "#/$defs/scope_authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stop_scope": {"enum": ["child", "cohort", "execution-path", "complete-task", "publication"]},
    "continuation_path": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "target_id", "conditions"],
      "properties": {
        "path": {"enum": ["retry-child", "replace-child", "continue-cohort", "retry-cohort", "alternate-execution-path", "resume-task", "task-remediation", "publication-review", "operator-adjudication"]},
        "target_id": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source_type", "source_id", "source_sha256", "actor_id", "actor_role", "identity_source", "authorized_scope", "parent_receipt_sha256", "verification", "authority_sha256"],
      "properties": {
        "version": {"const": 1},
        "source_type": {"enum": ["worker-discovery", "pm-observation", "architect-judgment", "operator-directive", "policy-enforcement"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["operative-worker", "critic", "project-manager", "architect", "supervisor-policy", "operator"]},
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {"$ref": "#/$defs/stop_scope"},
        "parent_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_record": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "authority_provenance", "detected_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "authority_provenance": {"$ref": "#/$defs/scope_authority"},
        "detected_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
