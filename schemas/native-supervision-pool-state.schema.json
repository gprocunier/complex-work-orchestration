{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Supervision Pool State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_type", "version", "schema", "pool_id", "pool_epoch", "contract_sha256",
    "state_sequence", "status", "owner", "coordinator_epoch", "scheduler_cursor",
    "active_children", "terminal_children", "children", "aggregate_usage",
    "pool_started_monotonic_ns", "pool_wall_seconds", "worker_seconds",
    "poll_overhead_seconds", "lease_bindings", "reasons", "reason_records", "first_protected_fault",
    "control_loss_scope", "stop_scope", "authorized_continuation_paths",
    "scope_authority", "state_sha256"
  ],
  "properties": {
    "state_type": {"const": "cwo-native-supervision-pool-state"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-supervision-pool-state.schema.json"},
    "pool_id": {"type": "string", "minLength": 1},
    "pool_epoch": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "state_sequence": {"type": "integer", "minimum": 0},
    "status": {"enum": ["created", "capability-validated", "admitting", "running", "draining", "interrupt-pending", "completed", "closed", "control-failed"]},
    "owner": {"$ref": "#/$defs/owner"},
    "coordinator_epoch": {"type": "integer", "minimum": 0},
    "scheduler_cursor": {"type": "integer", "minimum": 0, "maximum": 2},
    "active_children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "terminal_children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "children": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/child"}},
    "aggregate_usage": {"$ref": "#/$defs/usage"},
    "pool_started_monotonic_ns": {"type": "integer", "minimum": 0},
    "pool_wall_seconds": {"type": "number", "minimum": 0},
    "worker_seconds": {"type": "number", "minimum": 0},
    "poll_overhead_seconds": {"type": "number", "minimum": 0},
    "lease_bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reason_records": {"type": "array", "items": {"$ref": "#/$defs/reason_record"}},
    "first_protected_fault": {"oneOf": [{"$ref": "#/$defs/first_fault"}, {"type": "null"}]},
    "control_loss_scope": {"enum": [null, "child", "pool"]},
    "stop_scope": {"$ref": "#/$defs/stop_scope"},
    "authorized_continuation_paths": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/continuation_path"}
    },
    "scope_authority": {"$ref": "#/$defs/scope_authority"},
    "state_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["pid", "start_ticks", "boot_id_sha256"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["availability", "input", "cached_input", "output", "reasoning", "total", "unavailable_reason"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "input": {"type": ["integer", "null"], "minimum": 0},
        "cached_input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "unavailable_reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_calls", "runtime_seconds", "compactions", "full_suite_runs", "mutations", "tokens"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": "integer", "minimum": 0},
        "compactions": {"type": "integer", "minimum": 0},
        "full_suite_runs": {"type": "integer", "minimum": 0},
        "mutations": {"type": "integer", "minimum": 0},
        "tokens": {"$ref": "#/$defs/tokens"}
      }
    },
    "first_fault": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "operation", "observed_callback_latency_ms", "certified_callback_max_ms", "latched_state_sequence"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "operation": {"enum": [null, "arm", "send_input", "mark_dispatched", "check", "interrupt", "close", "finalize"]},
        "observed_callback_latency_ms": {"type": ["number", "null"], "minimum": 0},
        "certified_callback_max_ms": {"type": ["number", "null"], "minimum": 0},
        "latched_state_sequence": {"type": "integer", "minimum": 0}
      }
    },
    "stop_scope": {
      "enum": ["child", "cohort", "execution-path", "complete-task", "publication"]
    },
    "continuation_path": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "target_id", "conditions"],
      "properties": {
        "path": {"enum": ["retry-child", "replace-child", "continue-cohort", "retry-cohort", "alternate-execution-path", "resume-task", "task-remediation", "publication-review", "operator-adjudication"]},
        "target_id": {"type": ["string", "null"], "minLength": 1},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source_type", "source_id", "source_sha256", "actor_id", "actor_role", "identity_source", "authorized_scope", "parent_receipt_sha256", "verification", "authority_sha256"],
      "properties": {
        "version": {"const": 1},
        "source_type": {"enum": ["worker-discovery", "pm-observation", "architect-judgment", "operator-directive", "policy-enforcement"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["operative-worker", "critic", "project-manager", "architect", "supervisor-policy", "operator"]},
        "identity_source": {"type": "string", "minLength": 1},
        "authorized_scope": {"$ref": "#/$defs/stop_scope"},
        "parent_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "evidence_sha256"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_record": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "authority_provenance", "detected_by"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "authority_provenance": {"$ref": "#/$defs/scope_authority"},
        "detected_by": {"type": "string", "minLength": 1}
      }
    },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "child_id", "status", "last_deadline_ns", "next_deadline_ns", "child_state_sha256", "child_receipt_sha256", "last_cumulative_usage", "lease_id"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "child_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["created", "armed", "running", "interrupt-pending", "interrupt-confirmed", "completed", "closed", "control-failed"]},
        "last_deadline_ns": {"type": ["integer", "null"], "minimum": 0},
        "next_deadline_ns": {"type": ["integer", "null"], "minimum": 0},
        "child_state_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "child_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "last_cumulative_usage": {"$ref": "#/$defs/usage"},
        "lease_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
