{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Coach Result",
  "type": "object",
  "$defs": {
    "sparkDispatch": {
      "type": "object",
      "required": [
        "status",
        "requested_model",
        "requested_route",
        "failed_native_capability_check",
        "failed_native_capability_check_justification"
      ],
      "properties": {
        "status": {"enum": ["not-applicable", "native-first", "hard-stop"]},
        "requested_model": {"type": "string"},
        "requested_route": {"type": "string"},
        "failed_native_capability_check": {"type": "string"},
        "failed_native_capability_check_justification": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "coach_result_type",
    "version",
    "beads_tracking_required",
    "recommended_orchestration_level",
    "scaffold_sizing",
    "beads_context_depth",
    "beads_context_depth_provenance",
    "rationale",
    "missing_questions",
    "interactive_questions",
    "requires_user_selection_before_plan",
    "selection_before_plan_reason",
    "selection_before_plan_question_ids",
    "enabled_levers",
    "disabled_levers",
    "workerbee_parallelism",
    "workerbee_planned_delegation",
    "model_synthesis",
    "operator_calibration",
    "route",
    "paste_ready_prompt",
    "warnings"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "workerbee_parallelism": {
            "type": "object",
            "required": ["hard_stop"],
            "properties": {"hard_stop": {"const": true}}
          }
        },
        "required": ["workerbee_parallelism"]
      },
      "then": {
        "properties": {
          "interactive_questions": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {"id": {"const": "workerbee_parallelism"}}
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "coach_result_type": {"const": "complex-work-orchestration-prompt-coach"},
    "version": {"type": "integer"},
    "beads_tracking_required": {"const": true},
    "recommended_orchestration_level": {
      "enum": [
        "in-thread",
        "lightweight-beads",
        "full-harness",
        "external-contract",
        "local-worker",
        "publish-release"
      ]
    },
    "scaffold_sizing": {
      "type": "object",
      "required": ["recommended_size", "prompt_user_in_plan_mode", "rationale"],
      "properties": {
        "recommended_size": {"enum": ["full", "tight"]},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "beads_context_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
    "beads_context_depth_provenance": {
      "type": "object",
      "required": ["source", "requested_depth", "computed_depth", "effective_depth", "override_field", "reason", "actor_context"],
      "properties": {
        "source": {"enum": ["autosized", "explicit"]},
        "requested_depth": {
          "anyOf": [
            {"enum": ["none", "summary", "focused", "heavy", "audit"]},
            {"type": "null"}
          ]
        },
        "computed_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
        "effective_depth": {"enum": ["none", "summary", "focused", "heavy", "audit"]},
        "override_field": {
          "anyOf": [
            {"enum": ["beads_context_depth"]},
            {"type": "null"}
          ]
        },
        "reason": {"type": "string"},
        "actor_context": {"type": "string"}
      }
    },
    "rationale": {"type": "array", "items": {"type": "string"}},
    "missing_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "why", "default"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "why": {"type": "string"},
          "default": {"type": "string"}
        }
      }
    },
    "interactive_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "header", "question", "why", "options"],
        "properties": {
          "id": {"type": "string"},
          "header": {"type": "string", "maxLength": 12},
          "question": {"type": "string"},
          "why": {"type": "string"},
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label", "value", "description"],
              "properties": {
                "label": {"type": "string"},
                "value": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "requires_user_selection_before_plan": {"type": "boolean"},
    "selection_before_plan_reason": {"type": "string"},
    "selection_before_plan_question_ids": {"type": "array", "items": {"type": "string"}},
    "enabled_levers": {"type": "array", "items": {"type": "string"}},
    "disabled_levers": {"type": "array", "items": {"type": "string"}},
    "workerbee_parallelism": {
      "type": "object",
      "required": [
        "recommended_mode",
        "recommended_model",
        "spark_operational_worker",
        "hard_stop",
        "hard_stop_reason",
        "registry_tool_mismatch",
        "spark_dispatch",
        "prompt_user_in_plan_mode",
        "suggested_lanes",
        "rationale"
      ],
      "properties": {
        "recommended_mode": {
          "enum": ["none", "review-only", "heavy-review", "implementation-capable", "blocked"]
        },
        "recommended_model": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "spark_operational_worker": {"type": "boolean"},
        "hard_stop": {"type": "boolean"},
        "hard_stop_reason": {"type": "string"},
        "registry_tool_mismatch": {"type": "boolean"},
        "spark_dispatch": {"$ref": "#/$defs/sparkDispatch"},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "suggested_lanes": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {"hard_stop": {"const": true}},
            "required": ["hard_stop"]
          },
          "then": {
            "properties": {
              "recommended_mode": {"const": "blocked"},
              "recommended_model": {"type": "null"},
              "spark_operational_worker": {"const": false},
              "hard_stop_reason": {"type": "string", "minLength": 1},
              "registry_tool_mismatch": {"type": "boolean"},
              "suggested_lanes": {"maxItems": 0},
              "spark_dispatch": {
                "properties": {"status": {"const": "hard-stop"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"recommended_mode": {"const": "blocked"}},
            "required": ["recommended_mode"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true},
              "registry_tool_mismatch": {"type": "boolean"}
            }
          }
        },
        {
          "if": {
            "properties": {"registry_tool_mismatch": {"const": true}},
            "required": ["registry_tool_mismatch"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "spark_dispatch": {
                "type": "object",
                "required": ["status"],
                "properties": {"status": {"const": "hard-stop"}}
              }
            },
            "required": ["spark_dispatch"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true}
            }
          }
        }
      ]
    },
    "workerbee_planned_delegation": {
      "type": "object",
      "required": [
        "mode",
        "model",
        "lanes",
        "registry_tool_mismatch",
        "hard_stop",
        "hard_stop_reason",
        "spark_operational_worker",
        "spark_dispatch"
      ],
      "properties": {
        "mode": {"enum": ["none", "review-only", "heavy-review", "implementation-capable", "blocked"]},
        "model": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "lanes": {"type": "array", "items": {"type": "string"}},
        "recommended_mode": {"type": "string"},
        "recommended_model": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "suggested_lanes": {"type": "array", "items": {"type": "string"}},
        "registry_tool_mismatch": {"type": "boolean"},
        "hard_stop": {"type": "boolean"},
        "hard_stop_reason": {"type": "string"},
        "spark_operational_worker": {"type": "boolean"},
        "spark_dispatch": {"$ref": "#/$defs/sparkDispatch"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"hard_stop": {"const": true}},
            "required": ["hard_stop"]
          },
          "then": {
            "properties": {
              "mode": {"const": "blocked"},
              "model": {"type": "null"},
              "lanes": {"maxItems": 0},
              "registry_tool_mismatch": {"type": "boolean"},
              "hard_stop_reason": {"type": "string", "minLength": 1},
              "spark_operational_worker": {"const": false},
              "spark_dispatch": {
                "properties": {"status": {"const": "hard-stop"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "blocked"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true},
              "registry_tool_mismatch": {"type": "boolean"}
            }
          }
        },
        {
          "if": {
            "properties": {"registry_tool_mismatch": {"const": true}},
            "required": ["registry_tool_mismatch"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "spark_dispatch": {
                "type": "object",
                "required": ["status"],
                "properties": {"status": {"const": "hard-stop"}}
              }
            },
            "required": ["spark_dispatch"]
          },
          "then": {
            "properties": {
              "hard_stop": {"const": true}
            }
          }
        }
      ]
    },
    "model_synthesis": {
      "type": "object",
      "required": [
        "recommended_mode",
        "activation_state",
        "active",
        "active_modes",
        "requires_user_acceptance",
        "prompt_user_in_plan_mode",
        "synthesis_pattern",
        "synthesis_owner",
        "trigger_reasons",
        "recommended_panel",
        "mentioned_provider_camps",
        "required_share_boundary",
        "external_reviewers_require_opt_in",
        "artifact_contract",
        "input_disposition_policy",
        "partial_synthesis_policy",
        "provider_conflict_policy",
        "provider_conflict_flags",
        "rationale"
      ],
      "properties": {
        "recommended_mode": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "activation_state": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "active": {"type": "boolean"},
        "active_modes": {"type": "array", "items": {"type": "string"}},
        "requires_user_acceptance": {"type": "boolean"},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "synthesis_pattern": {"type": "string"},
        "synthesis_owner": {"type": "string"},
        "trigger_reasons": {"type": "array", "items": {"type": "string"}},
        "recommended_panel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["executor", "role", "provider_camp", "effort", "external"],
            "properties": {
              "executor": {"type": "string"},
              "role": {"type": "string"},
              "provider_camp": {"type": "string"},
              "effort": {"type": "string"},
              "external": {"type": "boolean"}
            }
          }
        },
        "mentioned_provider_camps": {"type": "array", "items": {"type": "string"}},
        "required_share_boundary": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "external_reviewers_require_opt_in": {"type": "boolean"},
        "artifact_contract": {"type": "array", "items": {"type": "string"}},
        "input_disposition_policy": {"type": "object"},
        "partial_synthesis_policy": {"type": "object"},
        "provider_conflict_policy": {"type": "object"},
        "provider_conflict_flags": {"type": "array", "items": {"type": "object"}},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operator_calibration": {
      "type": "object",
      "required": [
        "mode",
        "expert",
        "job_description_label",
        "trigger_reasons",
        "acceptance_question",
        "prompt_user_in_plan_mode",
        "rationale"
      ],
      "properties": {
        "mode": {"enum": ["none", "recommended", "required"]},
        "expert": {"const": "operator_calibrated_execution"},
        "job_description_label": {"const": "contract-jd-operator-calibrated-execution"},
        "trigger_reasons": {"type": "array", "items": {"type": "string"}},
        "acceptance_question": {"type": "string"},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "route": {"type": "object"},
    "paste_ready_prompt": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
