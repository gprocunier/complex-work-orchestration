{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Coach Result",
  "type": "object",
  "required": [
    "coach_result_type",
    "version",
    "beads_tracking_required",
    "recommended_orchestration_level",
    "rationale",
    "missing_questions",
    "interactive_questions",
    "enabled_levers",
    "disabled_levers",
    "workerbee_parallelism",
    "model_synthesis",
    "route",
    "paste_ready_prompt",
    "warnings"
  ],
  "properties": {
    "coach_result_type": {"const": "complex-work-orchestration-prompt-coach"},
    "version": {"type": "integer"},
    "beads_tracking_required": {"const": true},
    "recommended_orchestration_level": {
      "enum": [
        "in-thread",
        "lightweight-beads",
        "full-harness",
        "external-contract",
        "local-worker",
        "publish-release"
      ]
    },
    "rationale": {"type": "array", "items": {"type": "string"}},
    "missing_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "why", "default"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "why": {"type": "string"},
          "default": {"type": "string"}
        }
      }
    },
    "interactive_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "header", "question", "why", "options"],
        "properties": {
          "id": {"type": "string"},
          "header": {"type": "string", "maxLength": 12},
          "question": {"type": "string"},
          "why": {"type": "string"},
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["label", "value", "description"],
              "properties": {
                "label": {"type": "string"},
                "value": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "enabled_levers": {"type": "array", "items": {"type": "string"}},
    "disabled_levers": {"type": "array", "items": {"type": "string"}},
    "workerbee_parallelism": {
      "type": "object",
      "required": [
        "recommended_mode",
        "recommended_model",
        "prompt_user_in_plan_mode",
        "suggested_lanes",
        "rationale"
      ],
      "properties": {
        "recommended_mode": {
          "enum": ["none", "review-only", "heavy-review", "implementation-capable"]
        },
        "recommended_model": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "suggested_lanes": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model_synthesis": {
      "type": "object",
      "required": [
        "recommended_mode",
        "activation_state",
        "active",
        "active_modes",
        "requires_user_acceptance",
        "prompt_user_in_plan_mode",
        "synthesis_pattern",
        "synthesis_owner",
        "trigger_reasons",
        "recommended_panel",
        "mentioned_provider_camps",
        "required_share_boundary",
        "external_reviewers_require_opt_in",
        "artifact_contract",
        "input_disposition_policy",
        "partial_synthesis_policy",
        "provider_conflict_policy",
        "provider_conflict_flags",
        "rationale"
      ],
      "properties": {
        "recommended_mode": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "activation_state": {
          "enum": ["none", "recommended", "requested", "accepted", "disabled"]
        },
        "active": {"type": "boolean"},
        "active_modes": {"type": "array", "items": {"type": "string"}},
        "requires_user_acceptance": {"type": "boolean"},
        "prompt_user_in_plan_mode": {"type": "boolean"},
        "synthesis_pattern": {"type": "string"},
        "synthesis_owner": {"type": "string"},
        "trigger_reasons": {"type": "array", "items": {"type": "string"}},
        "recommended_panel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["executor", "role", "provider_camp", "effort", "external"],
            "properties": {
              "executor": {"type": "string"},
              "role": {"type": "string"},
              "provider_camp": {"type": "string"},
              "effort": {"type": "string"},
              "external": {"type": "boolean"}
            }
          }
        },
        "mentioned_provider_camps": {"type": "array", "items": {"type": "string"}},
        "required_share_boundary": {
          "anyOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "external_reviewers_require_opt_in": {"type": "boolean"},
        "artifact_contract": {"type": "array", "items": {"type": "string"}},
        "input_disposition_policy": {"type": "object"},
        "partial_synthesis_policy": {"type": "object"},
        "provider_conflict_policy": {"type": "object"},
        "provider_conflict_flags": {"type": "array", "items": {"type": "object"}},
        "rationale": {"type": "array", "items": {"type": "string"}}
      }
    },
    "route": {"type": "object"},
    "paste_ready_prompt": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
