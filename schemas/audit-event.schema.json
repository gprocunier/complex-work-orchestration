{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dispatch Audit Event",
  "type": "object",
  "required": ["dispatch_id", "event_type", "timestamp", "bead_id"],
  "properties": {
    "dispatch_id": {"type": "string"},
    "event_type": {"type": "string"},
    "quota_event_type": {"type": ["string", "null"]},
    "timestamp": {"type": "string"},
    "bead_id": {"type": ["string", "null"]},
    "epic_id": {"type": ["string", "null"]},
    "executor_key": {"type": "string"},
    "executor": {"type": "string"},
    "provider_key": {"type": "string"},
    "provider_family": {"type": "string"},
    "provider_trust_tier": {"type": "string"},
    "provider_retention_class": {"type": "string"},
    "executor_external": {"type": "boolean"},
    "provider_external": {"type": ["boolean", "null"]},
    "share_boundary": {"type": "string"},
    "disclosure_stage": {"type": "string"},
    "opt_in_basis": {"type": "string"},
    "quota_remaining": {"type": ["integer", "null"]},
    "packet_sha256": {"type": "string"},
    "expected_return_language": {"type": "string"},
    "expected_return_language_source": {"type": "string"},
    "return_language_status": {"type": "string"},
    "return_language_finding_count": {"type": "number", "minimum": 0},
    "detected_letter_scripts": {"type": "array", "items": {"type": "string"}},
    "unexpected_script_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "unicode_normalization_changed": {"type": "boolean"},
    "previous_event_hash": {"type": "string"},
    "dispatch_mode": {"type": "string"},
    "telemetry_kind": {"type": "string"},
    "telemetry_status": {"type": "string"},
    "telemetry_missing_reason": {"type": "string"},
    "telemetry_missing_reasons": {"type": "array", "items": {"type": "string"}},
    "telemetry_source": {"type": "string"},
    "telemetry_target_event_hash": {"type": "string"},
    "model": {"type": "string"},
    "model_label": {"type": "string"},
    "reasoning_label": {"type": "string"},
    "model_profile": {"type": "string"},
    "job_description_label": {"type": "string"},
    "review_surface": {"type": "string"},
    "source_inspection": {"type": "string"},
    "sources_inspected": {"type": "string"},
    "sources_not_inspected": {"type": "string"},
    "independent_verification": {"type": "string"},
    "packet_reported_claims": {"type": "string"},
    "review_surface_mismatch": {"type": "boolean"},
    "review_surface_required_evidence_missing": {"type": "boolean"},
    "review_surface_mismatch_reasons": {"type": "array", "items": {"type": "string"}},
    "master_review_packet_only_go_hold": {"type": "boolean"},
    "workerbee_planned_delegation": {
      "type": "object",
      "properties": {
        "mode": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "lanes": {"type": "array", "items": {"type": "string"}},
        "recommended_mode": {"type": "string"},
        "recommended_model": {"type": ["string", "null"]},
        "suggested_lanes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "workerbee_planned_mode": {"type": "string"},
    "workerbee_planned_model": {"type": "string"},
    "workerbee_planned_lanes": {"type": "array", "items": {"type": "string"}},
    "workerbee_actual_mode": {"type": "string"},
    "workerbee_actual_model": {"type": "string"},
    "workerbee_actual_lanes": {"type": "array", "items": {"type": "string"}},
    "workerbee_delegation_status": {"type": "string"},
    "workerbee_delegation_source": {"type": "string"},
    "workerbee_delegation_gap_reasons": {"type": "array", "items": {"type": "string"}},
    "expert_profile": {"type": "string"},
    "expert_profile_path": {"type": "string"},
    "expert_profile_included": {"type": "boolean"},
    "degraded_packet": {"type": "boolean"},
    "agent_model_calls": {"type": "number", "minimum": 0},
    "retry_count": {"type": "number", "minimum": 0},
    "retries": {"type": "number", "minimum": 0},
    "input_tokens": {"type": "number", "minimum": 0},
    "output_tokens": {"type": "number", "minimum": 0},
    "total_tokens": {"type": "number", "minimum": 0},
    "active_seconds": {"type": "number", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "execution_enabled": {"type": "boolean"},
    "response_chars": {"type": "number", "minimum": 0},
    "failure_reason_chars": {"type": "number", "minimum": 0},
    "failure_reason_sha256": {"type": "string"},
    "share_url_present": {"type": "boolean"},
    "share_url_sha256": {"type": "string"},
    "share_url_chars": {"type": "number", "minimum": 0},
    "local_status_code": {"type": "number", "minimum": 0},
    "local_response_sha256": {"type": "string"},
    "local_response_chars": {"type": "number", "minimum": 0},
    "local_error_body_sha256": {"type": "string"},
    "local_error_body_chars": {"type": "number", "minimum": 0},
    "included_artifacts_count": {"type": "number", "minimum": 0},
    "included_artifact_types": {"type": "array", "items": {"type": "string"}},
    "selected_snippets_count": {"type": "number", "minimum": 0},
    "selected_snippet_paths": {"type": "array", "items": {"type": "string"}},
    "selected_snippet_lines": {"type": "number", "minimum": 0},
    "packet_output_sha256": {"type": "string"},
    "model_attestation_present": {"type": "boolean"},
    "model_attestation_required": {"type": "boolean"},
    "model_attestation_status": {"type": "string"},
    "environment": {"type": "string"},
    "harness": {"type": "string"},
    "role": {"type": "string"},
    "agent": {"type": "string"},
    "variant": {"type": "string"},
    "capability_requirements": {"type": "array", "items": {"type": "string"}},
    "acceptance_score": {"type": "integer"},
    "sabotage_score": {"type": ["integer", "null"]},
    "malpractice_score": {"type": ["integer", "null"]},
    "peer_review_required": {"type": ["boolean", "null"]},
    "peer_review_status": {"type": ["string", "null"]},
    "implementation_blocked": {"type": ["boolean", "null"]},
    "hold_reasons": {"type": "array", "items": {"type": "string"}},
    "hold_classification": {"type": ["string", "null"]},
    "human_adjudication_required": {"type": ["boolean", "null"]},
    "recommended_disposition": {"type": ["string", "null"]},
    "provider_conflict_domains": {"type": "array", "items": {"type": "string"}},
    "workspace_mutation": {"type": ["object", "null"]},
    "local_profile": {"type": ["string", "null"]},
    "quarantine_recommended": {"type": ["boolean", "null"]},
    "verdict": {"type": "string"},
    "event_hash": {"type": "string"}
  }
}
