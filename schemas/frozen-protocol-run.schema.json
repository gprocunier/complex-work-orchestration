{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/frozen-protocol-run.schema.json",
  "title": "frozen-protocol-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "lock_sha256",
    "run_contract",
    "steering"
  ],
  "properties": {
    "schema_version": {"const": "cwo-frozen-protocol-run:v1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "lock_sha256": {"$ref": "#/$defs/sha256"},
    "run_contract": {"$ref": "#/$defs/runContract"},
    "steering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "instruction_sha256",
        "changed_locked_fields",
        "replacement_authorization_sha256",
        "repair_class"
      ],
      "properties": {
        "classification": {
          "enum": ["continue", "same-scope-repair", "replace-protocol"]
        },
        "instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed_locked_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "replacement_authorization_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "repair_class": {
          "oneOf": [
            {"type": "null"},
            {
              "enum": [
                "mechanical-derived-cache",
                "mechanical-permission-restoration",
                "controller-transport",
                "stale-verifier"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "continue"}}},
          "then": {
            "properties": {
              "changed_locked_fields": {"maxItems": 0},
              "replacement_authorization_sha256": {"type": "null"},
              "repair_class": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"classification": {"const": "same-scope-repair"}}},
          "then": {
            "properties": {
              "changed_locked_fields": {"maxItems": 0},
              "replacement_authorization_sha256": {"type": "null"},
              "repair_class": {
                "enum": [
                  "mechanical-derived-cache",
                  "mechanical-permission-restoration",
                  "controller-transport",
                  "stale-verifier"
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"classification": {"const": "replace-protocol"}}},
          "then": {
            "properties": {
              "changed_locked_fields": {"minItems": 1},
              "replacement_authorization_sha256": {"$ref": "#/$defs/sha256"},
              "repair_class": {"type": "null"}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "arms",
        "initial_cells",
        "compatibility_smoke_cells",
        "confirmation_max_cells",
        "retry_limit",
        "decision_rule_sha256",
        "immutable_fields",
        "forbidden_substitutions"
      ],
      "properties": {
        "scenario_count": {"type": "integer", "minimum": 1},
        "arms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "initial_cells": {"type": "integer", "minimum": 1},
        "compatibility_smoke_cells": {"type": "integer", "minimum": 0},
        "confirmation_max_cells": {"type": "integer", "minimum": 0},
        "retry_limit": {"type": "integer", "minimum": 0},
        "decision_rule_sha256": {"$ref": "#/$defs/sha256"},
        "immutable_fields": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_substitutions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
