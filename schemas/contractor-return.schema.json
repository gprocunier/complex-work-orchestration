{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contractor Return",
  "type": "object",
  "required": ["status", "contractor_job_description", "summary", "validation_result", "evidence", "confidence", "risks_or_gaps", "recommended_next_bead"],
  "properties": {
    "status": {"type": "string"},
    "contractor_job_description": {"type": "string"},
    "summary": {"type": "string"},
    "files_changed": {"type": ["array", "string"], "items": {"type": "string"}},
    "commands_run": {"type": ["array", "string"], "items": {"type": "string"}},
    "boundary_violation": {"type": ["boolean", "string"]},
    "patch_authorization": {"type": "string"},
    "secret_or_personal_data_spill": {"type": ["boolean", "string"]},
    "scope_compliance": {"type": "string"},
    "validation_result": {"type": "string"},
    "provider_policy_limitations": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "research_evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {"type": "string"},
          "claim": {"type": "string"},
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "source_locator": {"type": "string"},
          "citation_span": {"type": "string"},
          "quoted_excerpt": {"type": "string"},
          "source_reliability_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "relevance_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "support_type": {"type": "string"},
          "access_status": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "research_contradictions": {"type": "array", "items": {"type": "object"}},
    "research_reflection": {"type": "object"},
    "evidence_provenance": {"type": "string"},
    "attestation_or_reproducibility_note": {"type": "string"},
    "share_boundary_conformance": {"type": "string"},
    "peer_review_disposition": {"type": "string"},
    "alternatives_considered": {"type": ["array", "string"], "items": {"type": "string"}},
    "confidence": {"type": "string"},
    "risks_or_gaps": {"type": "string"},
    "recommended_next_bead": {"type": "string"},
    "escalation_needed": {"type": ["boolean", "string"]}
  }
}
