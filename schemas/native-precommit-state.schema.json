{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Native Precommit State",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "byte_offset", "boundary_sha256", "token_snapshot"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "byte_offset": {"type": "integer", "minimum": 1},
        "boundary_sha256": {"$ref": "#/$defs/hash"},
        "token_snapshot": {"type": ["object", "null"], "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_ms", "lag_tolerance_ms", "armed_at", "dispatched_at", "first_successful_poll_at", "last_successful_poll_at", "poll_count", "max_gap_ms", "late_poll_count", "uninterrupted"],
      "properties": {
        "interval_ms": {"type": "integer", "minimum": 100},
        "lag_tolerance_ms": {"type": "integer", "minimum": 0},
        "armed_at": {"type": ["string", "null"]},
        "dispatched_at": {"type": ["string", "null"]},
        "first_successful_poll_at": {"type": ["string", "null"]},
        "last_successful_poll_at": {"type": ["string", "null"]},
        "poll_count": {"type": "integer", "minimum": 0},
        "max_gap_ms": {"type": "integer", "minimum": 0},
        "late_poll_count": {"type": "integer", "minimum": 0},
        "uninterrupted": {"type": "boolean"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_calls", "custom_tool_calls", "context_compactions", "workspace_mutations", "workspace_evidence_sha256", "first_forbidden_event", "forbidden_events", "task_boundary_observed", "task_complete_observed"],
      "properties": {
        "function_calls": {"type": "integer", "minimum": 0},
        "custom_tool_calls": {"type": "integer", "minimum": 0},
        "context_compactions": {"type": "integer", "minimum": 0},
        "workspace_mutations": {"type": "integer", "minimum": 0},
        "workspace_evidence_sha256": {"$ref": "#/$defs/hash"},
        "first_forbidden_event": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "record_index"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "record_index": {"type": ["integer", "null"], "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        },
        "forbidden_events": {"type": "array", "items": {"type": "string"}},
        "task_boundary_observed": {"type": "boolean"},
        "task_complete_observed": {"type": "boolean"}
      }
    },
    "workspaceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "workdir"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "workdir": {"type": "string", "minLength": 1}
      }
    },
    "pollConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_ms", "lag_tolerance_ms", "arm_to_dispatch_max_ms"],
      "properties": {
        "interval_ms": {"type": "integer", "minimum": 100},
        "lag_tolerance_ms": {"type": "integer", "minimum": 0},
        "arm_to_dispatch_max_ms": {"type": "integer", "minimum": 100}
      }
    },
    "fitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "estimates"],
      "properties": {
        "decision": {"enum": ["accept", "pm-realignment", "architect-realignment"]},
        "estimates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_calls_p50", "tool_calls_p90", "runtime_seconds_p50", "runtime_seconds_p90"],
          "properties": {
            "tool_calls_p50": {"type": "integer", "minimum": 1},
            "tool_calls_p90": {"type": "integer", "minimum": 1},
            "runtime_seconds_p50": {"type": "integer", "minimum": 1},
            "runtime_seconds_p90": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "controlReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "control_turn_id", "submission_id", "at", "receipt_id"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "control_turn_id": {"type": "string", "minLength": 1},
        "submission_id": {"type": ["string", "null"]},
        "at": {"type": "string", "minLength": 1},
        "receipt_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": [
    "state_type", "version", "schema", "validation_rule_version", "state_id", "state_file",
    "packet_id", "work_unit_id", "bead_id", "attempt_nonce", "session_id", "session_file",
    "agent_id", "requested_model", "attested_model", "attestation_source", "work_plan_sha256",
    "fit_prompt", "fit_prompt_sha256", "workdir", "workspace_baseline", "baseline", "terminal",
    "owner_pid", "control_turn_id", "submission_id", "status", "decision", "reasons",
    "interrupt_requested", "closure_outcome", "poll_config", "polling", "observed",
    "final_response_sha256", "semantic_status", "fit_result", "control_receipts",
    "audit_event_hashes", "audit_file", "created_at", "updated_at", "closed_at"
  ],
  "properties": {
    "state_type": {"const": "cwo-native-precommit-state"},
    "version": {"const": 1},
    "schema": {"const": "schemas/native-precommit-state.schema.json"},
    "validation_rule_version": {"const": "native-precommit-receipt:v1"},
    "state_id": {"type": "string", "minLength": 1},
    "state_file": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "work_unit_id": {"type": "string", "minLength": 1},
    "bead_id": {"type": "string", "minLength": 1},
    "attempt_nonce": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "session_file": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "requested_model": {"const": "gpt-5.3-codex-spark"},
    "attested_model": {"const": "gpt-5.3-codex-spark"},
    "attestation_source": {"const": "trusted-control-plane-session-metadata"},
    "work_plan_sha256": {"$ref": "#/$defs/hash"},
    "fit_prompt": {"type": "string", "minLength": 1},
    "fit_prompt_sha256": {"$ref": "#/$defs/hash"},
    "workdir": {"type": "string", "minLength": 1},
    "workspace_baseline": {"$ref": "#/$defs/workspaceBaseline"},
    "baseline": {"$ref": "#/$defs/boundary"},
    "terminal": {"oneOf": [{"$ref": "#/$defs/boundary"}, {"type": "null"}]},
    "owner_pid": {"type": "integer", "minimum": 1},
    "control_turn_id": {"type": ["string", "null"]},
    "submission_id": {"type": ["string", "null"]},
    "status": {"enum": ["created", "armed", "fit-dispatched", "completed", "interrupt-pending", "control-failed", "closed"]},
    "decision": {"type": "string", "minLength": 1},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "interrupt_requested": {"type": "boolean"},
    "closure_outcome": {"enum": [null, "completed", "interrupted", "control-failed"]},
    "poll_config": {"$ref": "#/$defs/pollConfig"},
    "polling": {"$ref": "#/$defs/polling"},
    "observed": {"$ref": "#/$defs/observed"},
    "final_response_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "semantic_status": {"enum": ["pending", "valid", "invalid"]},
    "fit_result": {"oneOf": [{"$ref": "#/$defs/fitResult"}, {"type": "null"}]},
    "control_receipts": {"type": "array", "items": {"$ref": "#/$defs/controlReceipt"}},
    "audit_event_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
    "audit_file": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "closed_at": {"type": ["string", "null"]}
  }
}
