{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/full-auto-run-authorization-v12.schema.json",
  "title": "CWO Full-Auto Run Authorization v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_type", "version", "schema", "authorization_id",
    "run_generation", "live_generation", "predecessor_live_generation",
    "issued_at", "issued_by", "authorization_evidence_sha256",
    "authority_provenance", "initial_state", "scope", "bindings",
    "supersession", "executors", "resource_limits", "progress_gate",
    "mandatory_gates", "persistence", "forbidden", "live_relaunch_rule",
    "release", "canonical_authorization_sha256"
  ],
  "properties": {
    "authorization_type": {"const": "cwo-full-auto-run-authorization"},
    "version": {"const": 12},
    "schema": {"const": "schemas/full-auto-run-authorization-v12.schema.json"},
    "authorization_id": {"$ref": "full-auto-run-authorization.schema.json#/$defs/uuid"},
    "run_generation": {"type": "integer", "minimum": 1},
    "live_generation": {"type": "integer", "minimum": 1},
    "predecessor_live_generation": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "string", "format": "date-time"},
    "issued_by": {"const": "native-supervisor-policy"},
    "authorization_evidence_sha256": {"$ref": "full-auto-run-authorization.schema.json#/$defs/sha256"},
    "authority_provenance": {"$ref": "native-authority-provenance.schema.json"},
    "initial_state": {"const": "active"},
    "scope": {"$ref": "full-auto-run-authorization.schema.json#/$defs/scope"},
    "bindings": {"$ref": "full-auto-run-authorization-v11.schema.json#/$defs/bindings"},
    "supersession": {"$ref": "full-auto-run-authorization.schema.json#/$defs/supersession"},
    "executors": {"$ref": "full-auto-run-authorization.schema.json#/$defs/executors"},
    "resource_limits": {"$ref": "full-auto-run-authorization.schema.json#/$defs/resource_limits"},
    "progress_gate": {"$ref": "full-auto-run-authorization.schema.json#/$defs/progress_gate"},
    "mandatory_gates": {"$ref": "#/$defs/mandatory_gates"},
    "persistence": {"$ref": "full-auto-run-authorization.schema.json#/$defs/persistence"},
    "forbidden": {"$ref": "full-auto-run-authorization.schema.json#/$defs/forbidden"},
    "live_relaunch_rule": {"$ref": "full-auto-run-authorization.schema.json#/$defs/live_relaunch"},
    "release": {"$ref": "full-auto-run-authorization.schema.json#/$defs/release"},
    "canonical_authorization_sha256": {"$ref": "full-auto-run-authorization.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "mandatory_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strict_authorization_v12", "active_outer_authority_binding",
        "progress_qualification_validation", "contained_prior_generation_proof",
        "fresh_exact_spark_validation", "fresh_exact_sol_pre_mutation_receipt",
        "successor_contract_validation", "frozen_release_patch",
        "opus_second_line_review_adjudicated", "fresh_exact_sol_pre_live_receipt",
        "campaign_manifest_v8", "finite_predecessor_proof_dag",
        "read_once_predecessor_snapshots", "atomic_launch_claim",
        "interrupted_empty_boundary_predecessor_proof",
        "terminal_recovery_facts_binding", "consumed_steering_receipts_binding",
        "single_shot_per_generation_live_campaign",
        "main_thread_adjudication_each_gate", "guarded_primary_diff_stability",
        "staging_ci_before_main", "published_install_parity"
      ],
      "properties": {
        "strict_authorization_v12": {"const": true},
        "active_outer_authority_binding": {"const": true},
        "progress_qualification_validation": {"const": true},
        "contained_prior_generation_proof": {"const": true},
        "fresh_exact_spark_validation": {"const": true},
        "fresh_exact_sol_pre_mutation_receipt": {"const": true},
        "successor_contract_validation": {"const": true},
        "frozen_release_patch": {"const": true},
        "opus_second_line_review_adjudicated": {"const": true},
        "fresh_exact_sol_pre_live_receipt": {"const": true},
        "campaign_manifest_v8": {"const": true},
        "finite_predecessor_proof_dag": {"const": true},
        "read_once_predecessor_snapshots": {"const": true},
        "atomic_launch_claim": {"const": true},
        "interrupted_empty_boundary_predecessor_proof": {"const": true},
        "terminal_recovery_facts_binding": {"const": true},
        "consumed_steering_receipts_binding": {"const": true},
        "single_shot_per_generation_live_campaign": {"const": true},
        "main_thread_adjudication_each_gate": {"const": true},
        "guarded_primary_diff_stability": {"const": true},
        "staging_ci_before_main": {"const": true},
        "published_install_parity": {"const": true}
      }
    }
  }
}
