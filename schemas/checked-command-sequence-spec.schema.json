{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/checked-command-sequence-spec.schema.json",
  "title": "checked-command-sequence-spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_type",
    "version",
    "sequence_id",
    "packet_id",
    "work_plan_sha256",
    "workdir",
    "commands"
  ],
  "properties": {
    "spec_type": {"const": "cwo-checked-command-sequence-spec"},
    "version": {"const": 1},
    "sequence_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "work_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workdir": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_type",
        "version",
        "command_id",
        "mode",
        "argv",
        "cwd",
        "env",
        "inherit_environment",
        "stdin",
        "source",
        "preflights",
        "mutation_intent",
        "allowed_paths",
        "timeout_seconds"
      ],
      "properties": {
        "spec_type": {"const": "cwo-checked-command-spec"},
        "version": {"const": 1},
        "command_id": {"type": "string", "minLength": 1},
        "mode": {"const": "argv"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "cwd": {"type": "string", "minLength": 1},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "inherit_environment": {"type": "boolean"},
        "stdin": {"type": ["string", "null"]},
        "source": {"type": "null"},
        "preflights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"enum": ["json", "json-policy", "regex"]},
              "value": {"type": "string"}
            }
          }
        },
        "mutation_intent": {"enum": ["none", "workspace-scoped"]},
        "allowed_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mutation_intent": {"const": "workspace-scoped"}},
            "required": ["mutation_intent"]
          },
          "then": {
            "properties": {"allowed_paths": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
