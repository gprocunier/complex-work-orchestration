{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Operative Route (v2 and v3)",
  "oneOf": [
    {
      "$ref": "#/$defs/v2Route"
    },
    {
      "$ref": "#/$defs/v3Route"
    }
  ],
  "$defs": {
    "v2Route": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CWO Spark-first Operative Route",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_type",
        "version",
        "execution_environment",
        "risk_level",
        "data_sensitivity",
        "evaluated_at",
        "primary_model",
        "primary_executor",
        "primary_selection",
        "availability_status",
        "availability_reason",
        "availability_evidence",
        "availability_evidence_sha256",
        "capability_evidence_sha256",
        "policy_sha256",
        "work_estimate",
        "work_estimate_sha256",
        "fallback_fit_evidence",
        "fallback_fit_sha256",
        "recommended_model",
        "recommended_executor",
        "recommendation_reason",
        "user_selection",
        "user_selection_scope",
        "selected_model",
        "selected_executor",
        "selection_source",
        "dispatch_authorized",
        "protected_stop",
        "stop_reason",
        "fresh_segment",
        "aggregate_budget",
        "budget_reset",
        "fallback",
        "history"
      ],
      "properties": {
        "route_type": {
          "const": "cwo-operative-route"
        },
        "version": {
          "const": 2
        },
        "execution_environment": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "data_sensitivity": {
          "enum": [
            "public",
            "redacted",
            "internal",
            "restricted"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "minLength": 1
        },
        "primary_model": {
          "const": "gpt-5.3-codex-spark"
        },
        "primary_executor": {
          "type": "string",
          "minLength": 1
        },
        "primary_selection": {
          "const": "automatic-when-available"
        },
        "availability_status": {
          "enum": [
            "available",
            "verified-quota-exhausted",
            "verified-capacity-unavailable",
            "unknown",
            "model-mismatch",
            "control-fault",
            "security-fault"
          ]
        },
        "availability_reason": {
          "type": "string",
          "minLength": 1
        },
        "availability_evidence": {
          "type": "object"
        },
        "availability_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "work_estimate": {
          "type": [
            "object",
            "null"
          ]
        },
        "work_estimate_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_fit_evidence": {
          "type": [
            "object",
            "null"
          ]
        },
        "fallback_fit_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_model": {
          "enum": [
            null,
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "recommended_executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recommendation_reason": {
          "type": "string",
          "minLength": 1
        },
        "user_selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/waitSelection"
            },
            {
              "$ref": "#/$defs/fallbackSelection"
            }
          ]
        },
        "user_selection_scope": {
          "enum": [
            null,
            "current-bead",
            "current-wave",
            "until-spark-restored"
          ]
        },
        "selected_model": {
          "enum": [
            null,
            "gpt-5.3-codex-spark",
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "selected_executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "selection_source": {
          "enum": [
            null,
            "policy-primary",
            "user-explicit-fallback",
            "in-progress-segment"
          ]
        },
        "dispatch_authorized": {
          "type": "boolean"
        },
        "protected_stop": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "fresh_segment": {
          "type": "boolean"
        },
        "aggregate_budget": {
          "type": "object"
        },
        "budget_reset": {
          "const": false
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "model",
        "display_name",
        "policy_rank",
        "rank",
        "task_fit",
        "cache_strategy_valid",
        "quota_domain",
        "cached_input_metering_domain",
        "domain_independent",
        "live_available",
        "evidence_fresh",
        "exact_model",
        "control_eligible",
        "risk_eligible",
        "data_sensitivity_eligible",
        "headroom_sufficient",
        "aggregate_budget_sufficient",
        "eligible",
        "model_evidence_sha256",
        "inclusion_reasons",
        "exclusion_reasons",
        "task_fit_warning",
        "acknowledgement_required"
      ],
      "properties": {
        "executor": {
          "type": "string"
        },
        "model": {
          "enum": [
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "policy_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "task_fit": {
          "enum": [
            "strategic",
            "preferred",
            "compatible",
            "degraded",
            "ineligible"
          ]
        },
        "cache_strategy_valid": {
          "type": "boolean"
        },
        "quota_domain": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cached_input_metering_domain": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain_independent": {
          "type": "boolean"
        },
        "live_available": {
          "type": "boolean"
        },
        "evidence_fresh": {
          "type": "boolean"
        },
        "exact_model": {
          "type": "boolean"
        },
        "control_eligible": {
          "type": "boolean"
        },
        "risk_eligible": {
          "type": "boolean"
        },
        "data_sensitivity_eligible": {
          "type": "boolean"
        },
        "headroom_sufficient": {
          "type": "boolean"
        },
        "aggregate_budget_sufficient": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "model_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "task_fit_warning": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "acknowledgement_required": {
          "type": "boolean"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "waitSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice"
      ],
      "properties": {
        "choice": {
          "const": "wait-for-spark"
        }
      }
    },
    "fallbackSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selection_source",
        "selected_model",
        "selected_executor",
        "reason",
        "scope",
        "expires_when",
        "selected_at",
        "actor",
        "capability_evidence_sha256",
        "work_estimate_sha256",
        "fallback_fit_sha256",
        "policy_sha256",
        "candidate_evidence_sha256"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "selection_source": {
          "const": "user-explicit-fallback"
        },
        "selected_model": {
          "enum": [
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "selected_executor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "current-bead",
            "current-wave",
            "until-spark-restored"
          ]
        },
        "expires_when": {
          "type": "string",
          "minLength": 1
        },
        "selected_at": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "capability_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "work_estimate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fallback_fit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bead_id": {
          "type": "string",
          "minLength": 1
        },
        "wave_id": {
          "type": "string",
          "minLength": 1
        },
        "degraded_task_fit_acknowledged": {
          "type": "boolean"
        }
      }
    },
    "expiredSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selection_source",
        "selected_model",
        "selected_executor",
        "reason",
        "scope",
        "expires_when",
        "selected_at",
        "actor",
        "capability_evidence_sha256",
        "work_estimate_sha256",
        "fallback_fit_sha256",
        "policy_sha256",
        "candidate_evidence_sha256",
        "expired",
        "expiry_reason"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "selection_source": {
          "const": "user-explicit-fallback"
        },
        "selected_model": {
          "enum": [
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "selected_executor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "current-bead",
            "current-wave",
            "until-spark-restored"
          ]
        },
        "expires_when": {
          "type": "string",
          "minLength": 1
        },
        "selected_at": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "capability_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "work_estimate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fallback_fit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bead_id": {
          "type": "string",
          "minLength": 1
        },
        "wave_id": {
          "type": "string",
          "minLength": 1
        },
        "degraded_task_fit_acknowledged": {
          "type": "boolean"
        },
        "expired": {
          "const": true
        },
        "expiry_reason": {
          "const": "spark-restored-at-fresh-segment"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "format",
        "dispatch_eligible",
        "migration_required"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            null,
            "operative-fallback-selection-v2",
            "legacy-explicit-fallback"
          ]
        },
        "dispatch_eligible": {
          "type": "boolean"
        },
        "migration_required": {
          "type": "boolean"
        },
        "selected_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_executor": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "object"
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_required",
        "trigger",
        "recommended_model",
        "recommended_executor",
        "recommendation_reason",
        "work_estimate_sha256",
        "fallback_fit_sha256",
        "policy_sha256",
        "candidates",
        "options",
        "selection",
        "selected_model",
        "selected_executor",
        "selection_source",
        "scope",
        "expires_when",
        "expired_selection",
        "fitness_errors",
        "migration"
      ],
      "properties": {
        "decision_required": {
          "type": "boolean"
        },
        "trigger": {
          "enum": [
            null,
            "verified-quota-exhausted",
            "verified-capacity-unavailable"
          ]
        },
        "recommended_model": {
          "enum": [
            null,
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "recommended_executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recommendation_reason": {
          "type": "string",
          "minLength": 1
        },
        "work_estimate_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_fit_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "options": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/waitSelection"
            },
            {
              "$ref": "#/$defs/fallbackSelection"
            }
          ]
        },
        "selected_model": {
          "enum": [
            null,
            "gpt-5.5",
            "gpt-5.6-terra",
            "gpt-5.6-luna"
          ]
        },
        "selected_executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "selection_source": {
          "enum": [
            null,
            "user-explicit-fallback"
          ]
        },
        "scope": {
          "enum": [
            null,
            "current-bead",
            "current-wave",
            "until-spark-restored"
          ]
        },
        "expires_when": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expired_selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expiredSelection"
            }
          ]
        },
        "fitness_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration": {
          "$ref": "#/$defs/migration"
        }
      }
    },
    "v3Route": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dispatch_authorized": {
                "const": true
              }
            },
            "required": [
              "dispatch_authorized"
            ]
          },
          "then": {
            "properties": {
              "selected_model": {
                "enum": [
                  "gpt-5.6-luna",
                  "gpt-5.6-terra"
                ]
              },
              "selected_executor": {
                "type": "string",
                "minLength": 1
              },
              "stop_reason": {
                "type": "null"
              },
              "policy_active": {
                "const": true
              },
              "work_estimate_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "neutral_work_estimate_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "fit_evidence": {
                "$ref": "#/$defs/taskSelectedFit"
              },
              "fit_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "capability_evidence_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "qualification": {
                "$ref": "#/$defs/qualification"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "attempt": {
                "$ref": "#/$defs/attempt"
              },
              "aggregate_budget": {
                "$ref": "#/$defs/aggregateBudget"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "reasoning_effort": {
                "const": "high"
              }
            }
          }
        }
      ],
      "required": [
        "route_type",
        "version",
        "execution_environment",
        "risk_level",
        "data_sensitivity",
        "evaluated_at",
        "selected_model",
        "selected_executor",
        "dispatch_authorized",
        "protected_stop",
        "stop_reason",
        "policy_active",
        "policy_sha256",
        "portfolio_version",
        "selector_version",
        "binding_rule_version",
        "work_estimate_sha256",
        "neutral_work_estimate_sha256",
        "fit_evidence",
        "fit_sha256",
        "capability_evidence_sha256",
        "qualification",
        "provenance",
        "attempt",
        "aggregate_budget",
        "budget_reset",
        "role",
        "reasoning_effort",
        "selection_reason",
        "candidate_exclusions",
        "route_sha256"
      ],
      "properties": {
        "route_type": {
          "const": "cwo-operative-route"
        },
        "version": {
          "const": 3
        },
        "execution_environment": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "data_sensitivity": {
          "enum": [
            "public",
            "redacted",
            "internal",
            "restricted"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "selected_model": {
          "enum": [
            null,
            "gpt-5.6-luna",
            "gpt-5.6-terra"
          ]
        },
        "selected_executor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dispatch_authorized": {
          "type": "boolean"
        },
        "protected_stop": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "policy_active": {
          "type": "boolean"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "portfolio_version": {
          "const": 3
        },
        "selector_version": {
          "const": 1
        },
        "binding_rule_version": {
          "const": 1
        },
        "work_estimate_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "neutral_work_estimate_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit_evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskSelectedFit"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_evidence_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "oneOf": [
            {
              "$ref": "#/$defs/qualification"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "oneOf": [
            {
              "$ref": "#/$defs/attempt"
            },
            {
              "type": "null"
            }
          ]
        },
        "aggregate_budget": {
          "oneOf": [
            {
              "$ref": "#/$defs/aggregateBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_reset": {
          "const": false
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "candidate_exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateExclusion"
          },
          "uniqueItems": true
        },
        "route_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "receipt_sha256",
        "canary_sha256",
        "origin_issued_at",
        "origin_expires_at",
        "tool_profile_sha256",
        "control_image_sha256",
        "host_provenance_sha256",
        "command_sha256",
        "execution_sha256",
        "runner_sha256"
      ],
      "properties": {
        "model": {
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-terra"
          ]
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin_issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "origin_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "control_image_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "host_provenance_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "context_sha256",
        "scope_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "bead_id",
        "work_lineage_id",
        "ownership_sha256",
        "fresh_segment"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "bead_id": {
          "type": "string",
          "minLength": 1
        },
        "work_lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "ownership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fresh_segment": {
          "type": "boolean"
        }
      }
    },
    "aggregateBudget": {
      "oneOf": [
        {
          "$ref": "#/$defs/finiteAggregateBudget"
        },
        {
          "$ref": "#/$defs/maintenanceAggregateBudget"
        }
      ]
    },
    "candidateExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "exclusion_reasons"
      ],
      "properties": {
        "model": {
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-terra"
          ]
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "taskSelectedFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_type",
        "version",
        "binding_rule_version",
        "evaluated_at",
        "policy_version",
        "policy_sha256",
        "capability_evidence_sha256",
        "aggregate_budget_sha256",
        "context",
        "cache_profile",
        "classifications",
        "candidates",
        "work_estimate_sha256",
        "neutral_work_estimate_sha256",
        "fit_sha256"
      ],
      "properties": {
        "fit_type": {
          "const": "cwo-task-selected-fit"
        },
        "version": {
          "const": 3
        },
        "binding_rule_version": {
          "const": 1
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "aggregate_budget_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context": {
          "type": "object"
        },
        "cache_profile": {
          "type": "object"
        },
        "classifications": {
          "type": "object"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1
          }
        },
        "work_estimate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "neutral_work_estimate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fit_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finiteAggregateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calls_hard",
        "runtime_seconds_hard",
        "allocation_before",
        "allocation_ceiling",
        "terminal_reserve",
        "budget_reset_allowed"
      ],
      "properties": {
        "tool_calls_hard": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_seconds_hard": {
          "type": "integer",
          "minimum": 1
        },
        "allocation_before": {
          "type": "integer",
          "minimum": 0
        },
        "allocation_ceiling": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_reserve": {
          "type": "integer",
          "minimum": 0
        },
        "budget_reset_allowed": {
          "const": false
        }
      }
    },
    "maintenanceAggregateBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mission_id",
        "mission_sha256",
        "operation_id",
        "cumulative_before",
        "reservation",
        "budget_reset_allowed"
      ],
      "properties": {
        "mode": {
          "const": "maintenance-unbounded"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "mission_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "cumulative_before": {
          "type": "integer",
          "minimum": 0
        },
        "reservation": {
          "$ref": "#/$defs/maintenanceReservation"
        },
        "budget_reset_allowed": {
          "const": false
        }
      }
    },
    "maintenanceReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sessions",
        "tool_calls",
        "runtime_seconds",
        "cleanup_seconds",
        "max_concurrency"
      ],
      "properties": {
        "mode": {
          "const": "finite-operation"
        },
        "sessions": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
