{
  "version": 1,
  "description": "Outbound screening regression cases for nested credential values, encoded payloads, malformed structures and benign counterparts. These cases are used to develop screening rules and are not held-out evidence.",
  "sources": {
    "nested-structures": {
      "origin": "Nested credential containers, JSON values and data URI encodings with benign counterparts."
    },
    "credential-suffixes": {
      "origin": "Credential source suffixes and quoted encoding parameters with benign counterparts."
    },
    "malformed-and-encoded-values": {
      "origin": "Credential member variants, incomplete values and split encoded payloads with benign counterparts."
    },
    "credential-context-and-budgets": {
      "origin": "Credential quantities, embedded JSON and payload continuation budgets with benign counterparts."
    },
    "compound-names-and-payloads": {
      "origin": "Acronym and compound credential names and malformed payload continuations with benign counterparts."
    },
    "case-variants-and-views": {
      "origin": "Case variants, credential phrases, placeholders and alternate decoding views with benign counterparts."
    },
    "whole-values-and-joined-literals": {
      "origin": "Plural credentials, continued structures, joined literals and payload delimiters with benign counterparts."
    }
  },
