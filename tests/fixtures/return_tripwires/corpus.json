{
  "version": 1,
  "description": "Return tripwire regression corpus covering evaluator directives, unsafe execution, credential requests, scope expansion, security weakening, authority overrides and audit suppression. Fixed directive samples include a benign preservation control. Minimal pairs vary action, negation, correction and Markdown context. Hostile fixtures declare the expected evaluator verdict in both placements.",
  "sources": {
    "directive-and-control-samples": {
      "origin": "Fixed directive sentences and a benign preservation control."
    },
    "action-minimal-pairs": {
      "origin": "Minimal hostile and benign pairs varying action and instruction context."
    },
    "markup-and-action-scope": {
      "origin": "Markdown decoration, wrapped pipelines and action scope with benign counterparts."
    },
    "correction-and-negation-scope": {
      "origin": "Corrections, negations and decorated instructions with benign counterparts."
    },
    "synthetic-operational-returns": {
      "origin": "Synthetic return shapes using placeholder evidence, artifacts and requests across operational boundaries."
    }
  },
